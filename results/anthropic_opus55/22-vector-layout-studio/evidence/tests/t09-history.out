start history="\"0/0\""
== 9a one long drag (40 pointer moves) = one step
   title "{\"x\":60,\"y\":64,\"w\":560.2734,\"h\":112}" -> "{\"x\":251.9872,\"y\":154,\"w\":560.2734,\"h\":112}" ; history="\"1/0\"" labels="[\"Move\"]"
== 9b opacity slider scrub (pointer drag on the range) = one step
   opacity="0.65" history="\"2/0\"" last="\"Opacity\""
== 9c label scrub on a numeric field (font size 'Size' label) = one step
   fontSize="132" history="\"3/0\"" last="\"Font size\""
== 9d layer reorder = one step
   root order head="[\"title\",\"sky\"]" history="\"4/0\""
== 9e undo each unit (pan/zoom/selection changes between steps consume nothing)
   undo reorder -> root head="\"sky\"" sel="[\"title\"]" history="\"3/1\""
   after pan+zoom+select: history="\"3/1\"" sel="[\"sky\"]"
   undo scrub -> fontSize="112" sel="[\"title\"]" history="\"2/2\""
   undo slider -> opacity="1" history="\"1/3\""
   undo drag -> title="{\"x\":60,\"y\":64,\"w\":560.2734,\"h\":112}" history="\"0/4\""
   redo drag -> title="{\"x\":251.9872,\"y\":154,\"w\":560.2734,\"h\":112}" sel="[\"title\"]" history="\"1/3\""
== 9f new edit after undo clears the redo branch
   nudge -> history="\"2/0\"" (redo must be 0)
   redo attempt -> history="\"2/0\"" toast="Nothing to redo."
== 9g Escape during a drag restores geometry, no history
   mid-drag: title="{\"x\":383.8633,\"y\":220.7727,\"w\":560.2734,\"h\":112}" op="\"move\""
   after Esc+release: title="{\"x\":251.9872,\"y\":155,\"w\":560.2734,\"h\":112}" (was "{\"x\":251.9872,\"y\":155,\"w\":560.2734,\"h\":112}") history "\"2/0\"" -> "\"2/0\""
== 9h focus loss during a drag (switch to another tab mid-drag) cancels
   mid-drag: title="{\"x\":383.8633,\"y\":154,\"w\":560.2734,\"h\":112}"
   after focus loss: title="{\"x\":251.9872,\"y\":155,\"w\":560.2734,\"h\":112}" (was "{\"x\":251.9872,\"y\":155,\"w\":560.2734,\"h\":112}") history="\"2/0\"" op="null"
