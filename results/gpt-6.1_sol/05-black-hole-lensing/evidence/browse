#!/usr/bin/env bash
set -o pipefail
printf 'agent-browser --session orbital' >> evidence/logs/browser-commands.log
printf ' %q' "$@" >> evidence/logs/browser-commands.log
printf '\n' >> evidence/logs/browser-commands.log
agent-browser --session orbital "$@" 2>&1 | tee -a evidence/logs/browser-output.log
