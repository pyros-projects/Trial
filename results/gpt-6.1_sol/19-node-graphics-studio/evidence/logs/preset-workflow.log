agent-browser --session fieldwork --json eval window.studio.state
agent-browser --session fieldwork --json eval window.studio.diagnostics()
agent-browser --session fieldwork --json eval (()=>{const c=document.querySelector("#previewCanvas"),b=c.getContext("2d").getImageData(0,0,c.width,c.height).data,s=new Set();for(let i=0;i<b.length;i+=28)s.add(b[i]+","+b[i+1]+","+b[i+2]);return s.size})()
