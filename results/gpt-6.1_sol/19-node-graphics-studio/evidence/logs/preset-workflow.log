agent-browser --session fieldwork click #galleryNav
agent-browser --session fieldwork wait --fn document.querySelectorAll(".preset-card").length===11
agent-browser --session fieldwork wait 1000
agent-browser --session fieldwork screenshot evidence/screenshots/20-material-gallery.png
agent-browser --session fieldwork --json eval Array.from(document.querySelectorAll("[data-preset]")).map(e=>e.dataset.preset)
agent-browser --session fieldwork --json eval window.studio.diagnostics().renders
agent-browser --session fieldwork click [data-preset="neon"]
