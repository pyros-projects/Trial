<script id="planner-ui">
'use strict';
(()=>{
const C=PlannerCore,$=s=>document.querySelector(s),clone=x=>JSON.parse(JSON.stringify(x));
const paths={undo:'M8 7 3 12l5 5M3 12h10a6 6 0 0 1 6 6',redo:'m16 7 5 5-5 5M21 12H11a6 6 0 0 0-6 6',folder:'M3 7a2 2 0 0 1 2-2h5l2 3h7a2 2 0 0 1 2 2v9H3z',plus:'M12 5v14M5 12h14',minus:'M5 12h14',chevronLeft:'m14 5-7 7 7 7',chevronRight:'m10 5 7 7-7 7',gantt:'M3 5h10v4H3zM9 11h12v4H9zM4 17h8v3H4z',tasks:'M9 6h12M9 12h12M9 18h12M3 6h1M3 12h1M3 18h1',resources:'M16 21v-3a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v3M17 4a4 4 0 0 1 0 8M22 21v-3a4 4 0 0 0-3-3M13 7a4 4 0 1 1-8 0 4 4 0 0 1 8 0',details:'M4 3h16v18H4zM8 7h8M8 12h8M8 17h5',calendar:'M4 5h16v16H4zM4 10h16M8 3v4M16 3v4',flag:'M5 21V4l7-1 7 3-7 3-7-2',diamond:'m12 3 9 9-9 9-9-9z',info:'M12 11v6M12 7v1M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0',check:'m5 12 4 4L19 6',alert:'m12 3 10 18H2zM12 9v5M12 17v1',trash:'M3 6h18M9 6V3h6v3M6 6l1 15h10l1-15M10 10v7M14 10v7',download:'M12 3v12m-4-4 4 4 4-4M4 15v6h16v-6',link:'m9 15 6-6M9 7l2-2a5 5 0 0 1 7 7l-2 2M15 17l-2 2a5 5 0 0 1-7-7l2-2',clock:'M12 6v6l4 2M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0',arrow:'M4 12h16m-5-5 5 5-5 5'};
const icon=(name,size=16)=>`<svg width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="${paths[name]||paths.info}"/></svg>`;
const esc=v=>String(v).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const num=v=>v.trim()===''?NaN:Number(v);
let result=C.compute(C.seed()),model=result.model,selected='T3',undo=[],redo=[],view='gantt',critical=false,dayWidth=56,tableOrder='source',resourceStart=0,drag=null,dialogType='',draftResources=[];
const date=o=>C.workDate(model.project.startDate,o);
const shortDate=s=>{const [y,m,d]=s.split('-');return ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'][Number(m)-1]+' '+Number(d)+', '+y;};
const compactDate=s=>{const [y,m,d]=s.split('-');return ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'][Number(m)-1]+' '+Number(d);};
const weekdayName=s=>['Mon','Tue','Wed','Thu','Fri','Sat','Sun'][C.weekday(C.parseDate(s))];
function sortedTasks(r=result){const list=[...r.model.tasks];if(tableOrder==='id')list.sort((a,b)=>C.cmp(a.id,b.id));if(tableOrder==='priority')list.sort((a,b)=>a.priority-b.priority||C.cmp(a.id,b.id));if(tableOrder==='start')list.sort((a,b)=>r.schedule[a.id].start-r.schedule[b.id].start||C.cmp(a.id,b.id));return list;}
function task(id=selected){return model.tasks.find(t=>t.id===id);}
function resource(id){return model.resources.find(r=>r.id===id);}
function notice(message,error=false){const el=$('#status');el.className='status show'+(error?' error':'');el.setAttribute('role',error?'alert':'status');$('.status-text').textContent=message;$('#status-icon').innerHTML=icon(error?'alert':'check',15);}
function focusMemory(){const e=document.activeElement;if(!e||e===document.body)return null;return {id:e.id,label:e.getAttribute('aria-label'),start:e.selectionStart,end:e.selectionEnd,scroll:$('#inspector-body').scrollTop};}
function restoreFocus(f){if(!f)return;const e=f.id?document.getElementById(f.id):Array.from(document.querySelectorAll('[aria-label]')).find(e=>e.getAttribute('aria-label')===f.label);if(e){e.focus({preventScroll:true});try{if(f.start!=null)e.setSelectionRange(f.start,f.end);}catch{}}$('#inspector-body').scrollTop=f.scroll;}
function commit(proposed,message,options={}){try{const next=C.compute(proposed);if(JSON.stringify(next.model)===JSON.stringify(model)){if(next.warnings.length)notice(next.warnings.join('\n'));return true;}undo.push(clone(model));redo=[];model=next.model;result=next;if(options.selected!==undefined)selected=options.selected;if(!task())selected=model.tasks[0]?.id??null;renderAll();notice([message,...next.warnings].filter(Boolean).join('\n'));return true;}catch(e){if(options.dialog)dialogError(e.message);else{renderAll();notice('Plan unchanged. '+e.message,true);}return false;}}
function mutate(fn,message,options={}){const next=clone(model);fn(next);return commit(next,message,options);}
function history(direction){if(drag)cancelDrag();const from=direction==='undo'?undo:redo,to=direction==='undo'?redo:undo;if(!from.length)return;to.push(clone(model));model=from.pop();result=C.compute(model);if(!task())selected=model.tasks[0]?.id??null;renderAll();notice(direction==='undo'?'Previous plan restored.':'Change reapplied.');}
function reset(){if(drag)cancelDrag();model=C.seed();result=C.compute(model);selected='T3';undo=[];redo=[];resourceStart=0;tableOrder='source';$('#task-order').value='source';if($('#dialog').open)$('#dialog').close();renderAll();$('#timeline-viewport').scrollLeft=0;notice('Starting plan restored. Undo and redo history cleared.');}
function renderSummary(){const count=model.tasks.length,miles=model.tasks.filter(t=>!t.duration).length,delta=result.completion-result.cpm.completion;$('#project-name').textContent=model.project.name;$('#summary').innerHTML=`<article class="stat"><div class="stat-label">Actual completion</div><span class="stat-icon">${icon('calendar')}</span><div class="stat-value">${result.completion}<small>workdays</small></div><div class="stat-foot">${esc(shortDate(date(result.completion)))} · exclusive boundary</div></article><article class="stat"><div class="stat-label">Dependency-only completion</div><span class="stat-icon">${icon('link')}</span><div class="stat-value">${result.cpm.completion}<small>workdays</small></div><div class="stat-foot">${delta?delta+'d added by resources / dates':'No additional resource or date delay'}</div></article><article class="stat"><div class="stat-label">Tasks in your plan</div><span class="stat-icon">${icon('tasks')}</span><div class="stat-value">${count}<small>total</small></div><div class="stat-foot">${count-miles} tasks · ${miles} milestone${miles===1?'':'s'}</div></article><article class="stat"><div class="stat-label">Available resources</div><span class="stat-icon">${icon('resources')}</span><div class="stat-value">${model.resources.length}<small>resources</small></div><div class="stat-foot">${model.resources.reduce((sum,r)=>sum+r.capacity,0)} concurrent slots across your team</div></article>`;$('#undo').disabled=!undo.length;$('#redo').disabled=!redo.length;$('#undo').title=`Undo (${undo.length} source changes) · Ctrl / ⌘ Z`;$('#redo').title=`Redo (${redo.length} changes) · Ctrl / ⌘ Shift Z`;}
function timelineSVG(r,dw,exporting=false){const tasks=sortedTasks(r),span=Math.min(2601,Math.max(12,r.completion+3)),left=exporting?Math.max(350,...tasks.map(t=>t.name.length*7+72)):0,header=exporting?110:74,rh=exporting?58:62,footer=exporting?82:0,w=left+span*dw+20,h=header+tasks.length*rh+footer,rows=new Map(tasks.map((t,i)=>[t.id,i])),start=r.model.project.startDate,wd=o=>C.workDate(start,o),x=o=>left+o*dw;
const cpEdges=new Set(r.cpm.criticalEdges.map(e=>e.from+'>'+e.to));let s=`<svg xmlns="http://www.w3.org/2000/svg" class="timeline-svg" width="${w}" height="${h}" viewBox="0 0 ${w} ${h}" role="img" aria-label="${exporting?'Complete exported':'Interactive'} Gantt for ${esc(r.model.project.name)}"><title>${esc(r.model.project.name)} · actual schedule</title><defs><marker id="${exporting?'export-':''}arrow-normal" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="5" markerHeight="5" orient="auto"><path d="M0 1 7 4 0 7" fill="none" stroke="#b0bdac" stroke-width="1.2"/></marker><marker id="${exporting?'export-':''}arrow-critical" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="5" markerHeight="5" orient="auto"><path d="M0 1 7 4 0 7" fill="none" stroke="#8d75ad" stroke-width="1.2"/></marker></defs><rect width="${w}" height="${h}" fill="white"/>`;
if(exporting){s+=`<text x="20" y="28" font-size="22" fill="#253a35" font-family="sans-serif" font-weight="600">${esc(r.model.project.name)}</text><text x="20" y="49" font-size="11" fill="#7c8a73" font-family="sans-serif">Start ${start} · Actual completion ${r.completion} workdays (${wd(r.completion)}) · Dependency-only completion ${r.cpm.completion} workdays</text><text x="20" y="85" font-size="11" fill="#7c8a73">TASK / RESOURCE / ACTUAL DATES</text>`;}
for(let i=0;i<tasks.length;i++){s+=`<rect x="${left}" y="${header+i*rh}" width="${span*dw+20}" height="${rh}" fill="${!exporting&&tasks[i].id===selected?'#f3f8ef':i%2?'#fcfdf9':'white'}"/><line x1="0" x2="${w}" y1="${header+i*rh}" y2="${header+i*rh}" stroke="#eef1e8"/>`;}
const step=exporting?Math.max(1,Math.ceil(45/dw)):dw<36?2:1;
for(let d=0;d<span;d++){const iso=wd(d),weekbreak=d>0&&weekdayName(iso)==='Mon',xx=x(d);if(d%step===0||weekbreak){s+=`<line x1="${xx}" x2="${xx}" y1="${header-2}" y2="${h-footer}" stroke="${weekbreak?'#d5dfcc':'#eff2e9'}" ${weekbreak?'stroke-dasharray="3 4"':''}/>`;}if(d%step===0){s+=`<text x="${xx+dw/2}" y="${header-31}" text-anchor="middle" font-size="9" fill="#97a18f">${weekdayName(iso)}</text><text x="${xx+dw/2}" y="${header-14}" text-anchor="middle" font-size="11" fill="#6d8063">${exporting?iso.slice(5):Number(iso.slice(8))}</text>`;}if(weekbreak){s+=`<path d="M${xx-3} ${header-3}l4-6m0 6 4-6" fill="none" stroke="#a3b398" stroke-width="1"/><title>Weekend break before ${iso}</title>`;}}
if(!exporting)s+=`<text x="12" y="21" font-size="10" fill="#87947c">${esc(shortDate(start).replace(/ \d+,/, ''))}</text>`;
for(const t of tasks){const target=r.schedule[t.id],ty=header+rows.get(t.id)*rh+rh/2;for(const p of t.predecessors){const a=r.schedule[p],py=header+rows.get(p)*rh+rh/2,from=x(a.finish)+(r.model.tasks.find(t=>t.id===p).duration?0:9),to=x(target.start)-(t.duration?2:10),crit=critical&&cpEdges.has(p+'>'+t.id),mid=Math.max(from+8,to-12);s+=`<path d="M${from} ${py}H${mid}V${ty}H${to}" fill="none" stroke="${crit?'#8d75ad':'#bac6b4'}" stroke-width="${crit?1.7:1.1}" stroke-linejoin="round" marker-end="url(#${exporting?'export-':''}arrow-${crit?'critical':'normal'})"><title>${esc(p)} → ${esc(t.id)} · finish-to-start${crit?' · dependency critical':''}</title></path>`;}}
for(const [i,t]of tasks.entries()){const a=r.schedule[t.id],yy=header+i*rh+rh/2,xx=x(a.start),ww=t.duration*dw,isCrit=critical&&r.cpm.tasks[t.id].float===0,fill=isCrit?'#cbbade':t.resourceId==='R2'?'#dfe6ef':'#c9e3cd',textColor=isCrit?'#756087':'#517349';
if(exporting){s+=`<text x="20" y="${yy-6}" font-size="12" fill="#344c30">${esc(t.id)} · ${esc(t.name)}</text><text x="20" y="${yy+12}" font-size="9" fill="#8a977f">${esc(t.resourceId||'Unassigned')} · ${wd(a.start)} → ${wd(a.finish)} exclusive${t.duration?' · last '+wd(a.finish-1):' · milestone'}</text>`;}
if(a.resourceWait){s+=`<rect x="${x(a.candidate)}" y="${yy+17}" width="${a.resourceWait*dw}" height="3" rx="1.5" fill="#f3d392"/><line x1="${x(a.candidate)}" x2="${xx}" y1="${yy+17}" y2="${yy+17}" stroke="#bf9448" stroke-dasharray="2 4"/>`;if(a.resourceWait*dw>54)s+=`<text x="${x(a.candidate)+a.resourceWait*dw/2}" y="${yy+28}" text-anchor="middle" font-size="8" fill="#b08b47">${a.resourceWait}d resource wait</text>`;}
if(t.notBefore)s+=`<path d="M${x(a.notBeforeBound)} ${yy-22}v6m-3-3 3 3 3-3" fill="none" stroke="#bb9754" stroke-width="1.4"><title>Requested not-before ${esc(t.notBefore)} (offset ${a.notBeforeBound})</title></path>`;
const label=`${t.id} ${t.name}. Actual [${a.start}, ${a.finish}). Start ${wd(a.start)}. Exclusive finish ${wd(a.finish)}.${t.duration?' Last working date '+wd(a.finish-1)+'.':' Milestone.'}${a.resourceWait?' Resource wait '+a.resourceWait+' days.':''}`;
s+=`<g ${exporting?'':`class="gantt-bar${t.id===selected?' selected':''}" data-task="${esc(t.id)}" tabindex="0" role="button" aria-label="${esc(label)}" aria-pressed="${t.id===selected}"`}><title>${esc(label)}</title>`;
if(t.duration){s+=`<rect class="bar" x="${xx+2}" y="${yy-14}" width="${Math.max(ww-4,4)}" height="28" rx="5" fill="${fill}" stroke="${exporting?'#a8c4a4':'none'}"/>`;if(ww>43){const name=t.name.length*5.5<ww-16?t.name:t.id;s+=`<text x="${xx+ww/2}" y="${yy+4}" text-anchor="middle" font-size="10" fill="${textColor}" pointer-events="none">${esc(name)}</text>`;}}
else{s+=`<path class="diamond" d="M${xx} ${yy-9}l9 9-9 9-9-9z" fill="${isCrit?'#aa92c3':'#829f78'}"/><text x="${xx+17}" y="${yy+4}" font-size="10" fill="${textColor}" pointer-events="none">${esc(t.name)}</text>`;}
s+='</g>';}
if(exporting){const fy=h-49;s+=`<line x1="20" x2="${w-20}" y1="${h-footer+8}" y2="${h-footer+8}" stroke="#e3e8db"/><rect x="20" y="${fy-9}" width="10" height="10" rx="2" fill="#c9e3cd"/><text x="36" y="${fy}" font-size="10" fill="#718368">Task</text><rect x="100" y="${fy-9}" width="10" height="10" rx="2" fill="#cbbade"/><text x="116" y="${fy}" font-size="10" fill="#718368">Dependency critical${critical?' (highlighted)':' (toggle off)'}</text><rect x="335" y="${fy-9}" width="10" height="10" rx="2" fill="#f3d392"/><text x="351" y="${fy}" font-size="10" fill="#718368">Resource wait</text><path d="M460 ${fy-11}l6 6-6 6-6-6z" fill="#829f78"/><text x="473" y="${fy}" font-size="10" fill="#718368">Milestone</text><text x="20" y="${h-20}" font-size="10" fill="#87967d">Mon–Fri · // marks weekend breaks · finish boundaries exclusive · date flags show not-before constraints · source schedule recalculated by Project Planning Studio</text>`;}
return s+'</svg>';}
function renderTimeline(preview=result){const scroll=$('#timeline-viewport').scrollLeft,tasks=sortedTasks(preview);$('#timeline-title').textContent=shortDate(model.project.startDate).replace(/ \d+,/, '');$('#zoom-readout').textContent=Math.round(dayWidth/56*100)+'%';if(!tasks.length){$('#timeline-body').style.display='block';$('#gantt-labels').innerHTML='';$('#timeline').innerHTML=`<div class="empty">${icon('gantt',30)}<strong>Your next project starts here.</strong>Add a task or milestone to build your plan.<br><button class="btn primary" data-action="new-task">${icon('plus',14)} Add first task</button></div>`;}else{$('#timeline-body').style.display='';$('#gantt-labels').innerHTML=`<div class="gantt-label-header"><span>Task / Resource</span><small>Days</small></div>`+tasks.map(t=>{const a=preview.schedule[t.id];return `<button class="task-row${t.id===selected?' selected':''}" data-task="${esc(t.id)}" aria-label="Select ${esc(t.id)} ${esc(t.name)}" aria-pressed="${t.id===selected}"><span class="row-id" title="${esc(t.id)}">${esc(t.id)}</span><span class="row-content"><span class="row-name">${esc(t.name)}</span><span class="row-meta">${esc(t.resourceId||'Milestone'.repeat(t.duration===0)||'Unassigned')} ${t.predecessors.length?`<span class="row-deps">· after ${esc(t.predecessors.join(', '))}</span>`:''}</span></span>${a.resourceWait?'<span class="wait-dot" title="Resource waiting"></span>':''}<span class="row-duration">${t.duration?t.duration+'d':'◇'}</span></button>`;}).join('');$('#timeline').innerHTML=timelineSVG(preview,dayWidth);$('#timeline-viewport').scrollLeft=scroll;}}
function renderTable(){const tasks=sortedTasks();$('#table-count').textContent='· '+tasks.length;$('#task-table-body').innerHTML=tasks.map(t=>{const a=result.schedule[t.id],f=result.cpm.tasks[t.id].float;return `<tr class="${selected===t.id?'selected':''}" data-task-row="${esc(t.id)}"><td><button class="task-id-button" data-task="${esc(t.id)}" aria-label="Open details for ${esc(t.id)}">${esc(t.id)}</button></td><td><input class="inline name-input" value="${esc(t.name)}" data-inline="name" data-id="${esc(t.id)}" aria-label="Name for ${esc(t.id)}" maxlength="200"></td><td><input class="inline" type="number" min="0" max="260" step="1" value="${t.duration}" data-inline="duration" data-id="${esc(t.id)}" aria-label="Duration for ${esc(t.id)}"></td><td><input class="inline" type="number" min="0" max="9999" step="1" value="${t.priority}" data-inline="priority" data-id="${esc(t.id)}" aria-label="Priority for ${esc(t.id)}"></td><td><select class="inline" data-inline="resourceId" data-id="${esc(t.id)}" aria-label="Resource for ${esc(t.id)}" ${t.duration===0?'disabled':''}><option value="" ${!t.resourceId?'selected':''}>${t.duration===0?'Milestone':'Unassigned'}</option>${model.resources.map(r=>`<option value="${esc(r.id)}" ${r.id===t.resourceId?'selected':''}>${esc(r.id)} · ${esc(r.name)}</option>`).join('')}</select></td><td><button class="deps-button" data-task="${esc(t.id)}" title="Edit dependencies" aria-label="Dependencies for ${esc(t.id)}">${esc(t.predecessors.join(', ')||'—')}</button></td><td class="date-cell"><strong>[${a.start}, ${a.finish})</strong>${date(a.start)} → ${date(a.finish)}</td><td class="date-cell"><strong>${f}d${f===0?' · critical':''}</strong>dependency-only</td></tr>`;}).join('');if(!tasks.length)$('#task-table-body').innerHTML='<tr><td colspan="8"><div class="empty"><strong>No tasks yet.</strong>Create a task using the New task button.</div></td></tr>';}
function renderResources(){const end=Math.min(2600,resourceStart+13),days=Array.from({length:14},(_,i)=>resourceStart+i);$('#resource-range').textContent=compactDate(date(resourceStart))+' – '+compactDate(date(end))+' · offsets '+resourceStart+'–'+end;$('#resource-grid').innerHTML='<div class="resource-axis resource-name-cell">RESOURCE / CAPACITY</div>'+days.map(d=>`<div class="resource-axis">${d<=2600?weekdayName(date(d)):''}<strong>${d<=2600?compactDate(date(d)):'—'}</strong></div>`).join('')+model.resources.map(r=>`<div class="resource-name-cell"><strong>${esc(r.name)}</strong><span>${esc(r.id)}</span><label class="capacity-inline">Capacity <input type="number" min="1" max="4" step="1" value="${r.capacity}" data-capacity="${esc(r.id)}" aria-label="Capacity for ${esc(r.id)}"></label></div>`+days.map(d=>{const ids=result.occupancy[r.id][d]||[];return `<div class="resource-day"><div class="occupancy-count">${ids.length} / ${r.capacity}</div>${Array.from({length:r.capacity},(_,i)=>ids[i]?`<button class="resource-slot${selected===ids[i]?' selected':''}${critical&&result.cpm.tasks[ids[i]].float===0?' critical':''}" data-task="${esc(ids[i])}" aria-label="${esc(ids[i])} on ${d<=2600?date(d):''}, ${esc(r.id)} slot ${i+1}" title="${esc(task(ids[i]).name)} · ${d<=2600?date(d):''}">${esc(ids[i])}</button>`:'<span class="resource-slot empty-slot" aria-label="Free slot">—</span>').join('')}</div>`;}).join('')).join('');if(!model.resources.length)$('#resource-grid').innerHTML='<div class="empty"><strong>No named resources.</strong>Unassigned tasks are scheduled without capacity limits.</div>';const unassigned=model.tasks.filter(t=>!t.resourceId);$('#unassigned').innerHTML='<strong>Unassigned tasks &amp; milestones</strong>'+(unassigned.length?unassigned.map(t=>`<button class="chip${t.id===selected?' selected':''}" data-task="${esc(t.id)}">${t.duration?icon('tasks',11):icon('diamond',11)} ${esc(t.id)} · ${esc(t.name)}</button>`).join(''):'All positive tasks have a resource.')+'<div class="helper">Each positive task occupies one slot for every day in [start, finish). Milestones use no capacity. Select a slot to trace its task.</div>';}
function renderStrip(){$('#resource-strip').innerHTML=`<span class="strip-title">Your resources <small style="font-weight:400;color:#98a38e">· ${model.resources.length}</small></span><div class="strip-resources">${model.resources.slice(0,3).map((r,i)=>`<div class="strip-resource"><span class="resource-avatar${i%2?' review':''}">${esc(r.id)}</span><span>${esc(r.name)}<small>${r.capacity} concurrent slot${r.capacity===1?'':'s'}</small></span></div>`).join('')}</div><button class="strip-link" data-action="manage-resources">Manage ${icon('arrow',12)}</button>`;}
function renderInspector(){const t=task();$('#inspector-id').textContent=t?.id||'—';if(!t){$('#inspector-body').innerHTML=`<div class="empty">${icon('details',30)}<strong>A closer look at your plan.</strong>Select a task in any view to edit it and see why it starts when it does.</div>`;return;}const a=result.schedule[t.id],c=result.cpm.tasks[t.id],r=resource(t.resourceId);$('#inspector-body').innerHTML=`<h2>${esc(t.name)}</h2><div class="badges"><span class="badge">${t.duration?(r?esc(r.id)+' · '+esc(r.name):'Unassigned'):'◇ Milestone'}</span>${a.resourceWait?`<span class="badge wait">${a.resourceWait}d resource wait</span>`:''}${a.dateWait?`<span class="badge wait">${a.dateWait}d date constraint</span>`:''}${!c.float?'<span class="badge critical">Dependency critical</span>':`<span class="badge critical">${c.float}d dependency float</span>`}</div><div class="date-pair"><div class="date-box"><span>Actual start</span><strong>${esc(compactDate(date(a.start)))}</strong><small>Offset ${a.start} · ${weekdayName(date(a.start))}</small></div><div class="date-box"><span>Exclusive finish</span><strong>${esc(compactDate(date(a.finish)))}</strong><small>Offset ${a.finish} · ${weekdayName(date(a.finish))}</small></div></div><p class="last-work">${t.duration?'Last working date: <strong>'+date(a.finish-1)+'</strong>. Work ends before the finish boundary.':'A milestone is a boundary. It occupies no working days or resource slots.'}</p>
<form id="task-edit-form" novalidate><label class="field"><span>Name</span><input class="input" id="edit-name" name="name" aria-label="Selected task name" value="${esc(t.name)}" maxlength="200"></label><div class="field-row"><label class="field"><span>Duration · working days</span><input class="input" id="edit-duration" name="duration" type="number" min="0" max="260" step="1" value="${t.duration}" aria-label="Selected task duration"></label><label class="field"><span>Priority · lower first</span><input class="input" id="edit-priority" name="priority" type="number" min="0" max="9999" step="1" value="${t.priority}" aria-label="Selected task priority"></label></div><label class="field"><span>Assigned resource</span><select class="input" id="edit-resource" name="resourceId" aria-label="Selected task resource"><option value="" ${!t.resourceId?'selected':''}>Unassigned / milestone</option>${model.resources.map(r=>`<option value="${esc(r.id)}" ${r.id===t.resourceId?'selected':''}>${esc(r.id)} · ${esc(r.name)}</option>`).join('')}</select></label><label class="field" for="edit-not-before"><span>Not before · YYYY-MM-DD</span><span class="date-control"><input class="input" id="edit-not-before" name="notBefore" type="text" inputmode="numeric" value="${esc(t.notBefore||'')}" placeholder="No date constraint" aria-label="Not before date"><span class="native-picker" title="Choose a date">${icon('calendar',15)}<input type="date" min="2000-01-01" max="2099-12-31" value="${esc(t.notBefore||'')}" id="edit-date-picker" aria-label="Choose not-before date"></span></span><span class="helper">Weekend dates move forward to Monday. Dragging sets this constraint.</span></label>${t.notBefore?'<button type="button" class="clear-constraint" data-action="clear-constraint">Clear date constraint</button>':''}<label class="field" style="margin-top:10px"><span>Predecessor IDs · comma separated</span><input class="input" id="edit-predecessors" name="predecessors" value="${esc(t.predecessors.join(', '))}" placeholder="No predecessors" aria-label="Predecessor IDs"></label><details class="dependency-chooser"><summary>Choose dependencies ${icon('chevronRight',10)}</summary><div class="checkbox-list">${model.tasks.filter(x=>x.id!==t.id).map(x=>`<label><input type="checkbox" data-dependency="${esc(x.id)}" ${t.predecessors.includes(x.id)?'checked':''}>${esc(x.id)} · ${esc(x.name)}</label>`).join('')||'No other tasks yet.'}</div></details><button class="btn primary apply-button" type="submit">Apply changes ${icon('check',13)}</button></form>
<section class="inspector-section"><h3 class="why-title">${icon('info',14)} Why this start?</h3><div class="bound-row"><span>Predecessor finish bound</span><strong>${a.predecessorBound} · ${compactDate(date(a.predecessorBound))}</strong></div><div class="helper">${t.predecessors.length?t.predecessors.map(p=>esc(p)+' finishes at '+result.schedule[p].finish).join(' · '):'Root task: no predecessors.'}</div><div class="bound-row"><span>Not-before bound</span><strong>${t.notBefore?a.notBeforeBound+' · '+esc(t.notBefore):'0 · no constraint'}</strong></div><div class="bound-row"><span>Candidate boundary</span><strong>max(bounds) = ${a.candidate}</strong></div><div class="bound-row chosen"><span>Chosen actual start</span><strong>${a.start} · ${date(a.start)}</strong></div>${a.blockers.length?`<div class="blocker"><strong>${esc(r?.name||'Resource')} was fully occupied.</strong><br>${a.blockers.map(b=>`[${b.from}, ${b.to}) · ${b.ids.map(id=>`<button data-task="${esc(id)}">${esc(id)}</button>`).join(', ')}<br>${compactDate(date(b.from))}–${compactDate(date(b.to-1))}`).join('<br>')}<br>The earliest ${t.duration} consecutive free workdays start at ${a.start}.</div>`:`<p class="no-wait">${!t.duration?'Milestone: placed directly at its candidate boundary.':!t.resourceId?'Unassigned: no resource slot search needed.':'No resource booking blocks this task at its candidate boundary.'}</p>`}${a.dateWait?`<p class="no-wait" style="color:#a9853d">The not-before constraint adds ${a.dateWait} days beyond the predecessor bound.</p>`:''}</section>
<details class="cpm-box"><summary><span>Dependency-only CPM</span><strong>${c.float}d total float ${icon('chevronRight',10)}</strong></summary><div class="cpm-grid"><span>Earliest start<strong>${c.es} · ${compactDate(date(c.es))}</strong></span><span>Earliest finish<strong>${c.ef} · ${compactDate(date(c.ef))}</strong></span><span>Latest start<strong>${c.ls} · ${compactDate(date(c.ls))}</strong></span><span>Latest finish<strong>${c.lf} · ${compactDate(date(c.lf))}</strong></span></div><p>Unlimited resources; date constraints ignored. A common finish follows all terminal tasks. This float describes dependency flexibility.</p></details><button class="delete-task" data-action="delete-task">${icon('trash',12)} Delete ${esc(t.id)}</button>`;}
function renderViews(){for(const v of ['gantt','tasks','resources'])$('#view-'+v).hidden=view!==v&&!(view==='details'&&innerWidth>700&&v==='gantt');$('#workspace').classList.toggle('mobile-details',view==='details'&&innerWidth<=700);document.querySelectorAll('[data-view]').forEach(e=>{e.classList.toggle('active',e.dataset.view===view);e.setAttribute('aria-pressed',e.dataset.view===view);});}
function renderAll(){const focus=focusMemory();renderSummary();renderTimeline();renderTable();renderResources();renderStrip();renderInspector();renderViews();restoreFocus(focus);}
function setSelection(id,openMobile=false){if(!task(id))return;if(selected!==id){selected=id;renderTimeline();renderTable();renderResources();renderInspector();}if(openMobile&&innerWidth<=700)setView('details');}
function setView(v){view=v;if(v==='resources'&&task()){const s=result.schedule[selected].start;resourceStart=Math.min(2587,Math.floor(s/14)*14);renderResources();}renderViews();}
function dialogError(message){const e=$('#dialog-error');if(e){e.textContent='Plan unchanged. '+message;e.className='dialog-error show';}else notice(message,true);}
const dialogErrorHTML='<div class="dialog-error" id="dialog-error" role="alert" aria-live="polite"></div>';
function showDialog(type,title,content){dialogType=type;$('#dialog-title').textContent=title;$('#dialog-content').innerHTML=content;if(!$('#dialog').open)$('#dialog').showModal();}
function nextId(prefix,collection){let n=1;while(collection.some(t=>t.id===prefix+n))n++;return prefix+n;}
function newTask(milestone=false){showDialog('new-task','Add to your plan',`<form id="new-task-form" novalidate><div class="dialog-body">${dialogErrorHTML}<div class="type-choice"><button type="button" class="btn ${!milestone?'active':''}" data-action="new-task">${icon('tasks')} Task</button><button type="button" class="btn ${milestone?'active':''}" data-action="new-milestone">${icon('diamond')} Milestone</button></div><div class="field-row"><label class="field"><span>Stable task ID</span><input class="input" name="id" id="new-task-id" value="${nextId(milestone?'M':'T',model.tasks)}" aria-label="New task ID" maxlength="64"></label><label class="field"><span>Priority · 0–9999</span><input class="input" type="number" name="priority" value="${Math.min(9999,Math.max(0,...model.tasks.map(t=>t.priority))+1)}" aria-label="New task priority"></label></div><label class="field"><span>Task name</span><input class="input" name="name" placeholder="What needs to happen?" aria-label="New task name" maxlength="200"></label><div class="field-row"><label class="field"><span>Duration · 0–260 workdays</span><input class="input" type="number" name="duration" value="${milestone?0:1}" aria-label="New task duration" ${milestone?'readonly':''}></label><label class="field"><span>Resource</span><select class="input" name="resourceId" aria-label="New task resource" ${milestone?'disabled':''}><option value="">${milestone?'No resource':'Unassigned'}</option>${model.resources.map(r=>`<option value="${esc(r.id)}">${esc(r.id)} · ${esc(r.name)}</option>`).join('')}</select></label></div><label class="field"><span>Predecessor IDs · comma separated</span><input class="input" name="predecessors" aria-label="New task predecessors" placeholder="e.g. T1, T2"></label><label class="field"><span>Not before · YYYY-MM-DD (optional)</span><input class="input" name="notBefore" aria-label="New task not-before date" placeholder="No constraint"></label><p class="helper">IDs remain stable when names or display order change. A milestone has zero duration and no resource.</p></div><div class="dialog-foot"><button type="button" class="btn" data-action="close-dialog">Cancel</button><button type="submit" class="btn primary">Create ${milestone?'milestone':'task'}</button></div></form>`);}
function projectDialog(){showDialog('project','Project settings',`<form id="project-form" novalidate><div class="dialog-body">${dialogErrorHTML}<label class="field"><span>Project name</span><input class="input" name="name" value="${esc(model.project.name)}" aria-label="Project name" maxlength="200"></label><label class="field"><span>Project start · YYYY-MM-DD</span><input class="input" name="startDate" value="${esc(model.project.startDate)}" aria-label="Project start date"></label><p>Monday–Friday calendar, with no holidays. Weekend starts normalize forward to Monday. Supported dates: 2000-01-01 through 2099-12-31.</p></div><div class="dialog-foot"><button type="button" class="btn" data-action="close-dialog">Cancel</button><button class="btn primary" type="submit">Apply project settings</button></div></form>`);}
function resourcesDialog(){draftResources=clone(model.resources);paintResourceDialog();}
function paintResourceDialog(){showDialog('resources','Manage resources',`<form id="resources-form" novalidate><div class="dialog-body">${dialogErrorHTML}<p style="margin-top:0">Each task occupies one slot. Capacity changes the bookings the scheduler can place together.</p><div class="resource-editor-row" style="color:#839776;font-size:10px"><span>ID</span><span>Name</span><span>Capacity</span><span></span></div>${draftResources.map(r=>`<div class="resource-editor-row"><span title="${esc(r.id)}">${esc(r.id)}</span><input class="input" value="${esc(r.name)}" data-resource-name="${esc(r.id)}" aria-label="Resource name for ${esc(r.id)}" maxlength="200"><input class="input" type="number" min="1" max="4" step="1" value="${r.capacity}" data-resource-capacity="${esc(r.id)}" aria-label="Edit capacity for ${esc(r.id)}"><button class="quiet-btn" type="button" data-delete-resource="${esc(r.id)}" aria-label="Delete resource ${esc(r.id)}">${icon('trash',14)}</button></div>`).join('')}<h3>Add a resource</h3><div class="field-row"><label class="field"><span>Stable resource ID</span><input class="input" name="newId" value="${nextId('R',draftResources)}" aria-label="New resource ID"></label><label class="field"><span>Capacity · 1–4</span><input class="input" name="newCapacity" type="number" min="1" max="4" step="1" value="1" aria-label="New resource capacity"></label></div><label class="field"><span>Resource name</span><input class="input" name="newName" aria-label="New resource name" placeholder="e.g. Engineering" maxlength="200"></label><button type="button" class="btn soft" data-action="add-resource">${icon('plus',13)} Add resource to draft</button></div><div class="dialog-foot"><button type="button" class="btn" data-action="close-dialog">Cancel</button><button type="submit" class="btn primary">Apply resources</button></div></form>`);}
function readResourceDraft(){draftResources=draftResources.map(r=>({...r,name:Array.from(document.querySelectorAll('[data-resource-name]')).find(e=>e.dataset.resourceName===r.id)?.value??r.name,capacity:num(Array.from(document.querySelectorAll('[data-resource-capacity]')).find(e=>e.dataset.resourceCapacity===r.id)?.value??String(r.capacity))}));}
function deleteTaskDialog(){const t=task();if(!t)return;const dependents=model.tasks.filter(x=>x.predecessors.includes(t.id));showDialog('delete-task','Delete '+t.id+'?',`<div class="dialog-body">${dialogErrorHTML}<p>${esc(t.name)} will be removed from this plan.</p>${dependents.length?`<div class="blocker">${esc(dependents.map(x=>x.id).join(', '))} ${dependents.length===1?'depends':'depend'} on ${esc(t.id)}. Explicitly remove those dependency edges to delete this task.</div>`:'<p>No other task depends on it.</p>'}<p>Undo restores the task and every dependency edge.</p></div><div class="dialog-foot"><button class="btn" data-action="close-dialog">Cancel</button><button class="btn danger" data-action="confirm-delete-task">${dependents.length?'Delete & remove edges':'Delete task'}</button></div>`);}
function filesDialog(){showDialog('files','Keep your plan moving',`<div class="dialog-body">${dialogErrorHTML}<h3 style="margin-top:0">Export the current plan</h3><div class="export-buttons"><button class="btn" data-action="export-json">${icon('download',20)} Download JSON</button><button class="btn" data-action="export-csv">${icon('tasks',20)} Download CSV</button><button class="btn" data-action="export-svg">${icon('gantt',20)} Download Gantt SVG</button></div><p class="file-notice">JSON keeps all editable source data. CSV includes actual dates, exclusive finishes, last workdays and dependency-only float. SVG captures the complete current Gantt.</p><h3>Import a plan</h3><label class="field"><span>Choose a JSON file · maximum 2 MiB</span><input class="file-picker" type="file" id="import-file" accept=".json,application/json" aria-label="Import JSON file"></label><form id="import-form" novalidate><label class="field"><span>Or paste / type JSON below</span><textarea class="input import-area" id="import-text" name="json" aria-label="Plan JSON" spellcheck="false" placeholder='{"version":1,"project":{…},"resources":[…],"tasks":[…]}'></textarea></label><button type="submit" class="btn primary">Import JSON</button></form><p class="helper">The entire file is validated before replacement. A valid import is one undoable action. Cached schedules are ignored.</p><details class="schema"><summary>JSON v1 format &amp; input limits</summary><pre>{
  "version": 1,
  "project": {"name": "Project name", "startDate": "2026-09-07"},
  "resources": [{"id": "R1", "name": "Team", "capacity": 1}],
  "tasks": [{"id": "A", "name": "Task", "duration": 2,
    "priority": 0, "resourceId": "R1", "predecessors": [],
    "notBefore": null}]
}</pre><p>Use null for unassigned resourceId and absent notBefore. All keys shown are required. IDs: 1–64 ASCII letters, digits, underscores, hyphens. Names: 1–200 characters. At most 200 tasks and 32 resources; duration 0–260, priority 0–9999, capacity 1–4. All numbers must be safe integers. Dates 2000–2099; working-day boundaries 0–2600.</p></details></div><div class="dialog-foot"><button class="btn" data-action="close-dialog">Done</button></div>`);}
function helpDialog(){showDialog('help','A little clarity for your plan',`<div class="dialog-body"><h3 style="margin-top:0">One schedule, every view</h3><p>Select a task label, bar, resource slot or task ID to inspect the same task. Edit cells directly, or use the inspector and Apply changes. Use New task to add work or a milestone.</p><h3>How start dates are chosen</h3><p>The scheduler chooses the ready task with the lowest numeric priority, then the smallest case-sensitive stable ID. Its candidate is the latest of zero, its not-before offset and all predecessor finishes. It searches for the earliest consecutive resource gap; previously placed tasks stay fixed. This bounded serial policy does not promise a globally optimal plan.</p><h3>Dependency-only critical path</h3><p>CPM uses durations and dependencies with unlimited resources, ignoring not-before dates. All terminal tasks connect to a common finish. Zero total float marks dependency-critical tasks. Highlighted edges connect zero-float tasks whose predecessor earliest finish equals successor earliest start. Actual resource or date delay is shown separately.</p><h3>A working-day calendar</h3><p>Offset zero is the normalized project start. Only Monday–Friday count, with no holidays. Weekend date constraints move forward to Monday. Dates before start impose offset zero. A positive task occupies [start, finish); finish is exclusive. The last working date appears in Details and CSV. Milestones occupy no capacity.</p><h3>Drag, pan &amp; recover</h3><p>Drag a bar or milestone to request a not-before boundary. The preview recalculates every task; a booking can still force a later start. Release to apply once; Escape cancels. The labeled date field and calendar picker offer the same constraint. Scroll the timeline or use pan arrows; zoom and Fit adjust scale. View changes and selection never add history. Undo / redo restores source then recalculates.</p><h3>Declared limits</h3><ul class="limit-list"><li>200 tasks, 32 resources; 2 MiB per JSON import.</li><li>Names: 1–200 characters. IDs: 1–64 ASCII letters, digits, underscores or hyphens; IDs compare in case-sensitive code-point order.</li><li>Duration: integer 0–260. Priority: integer 0–9999. Capacity: integer 1–4. All numbers must be safe integers.</li><li>Dates: 2000-01-01 through 2099-12-31, including normalized and derived dates.</li><li>Working-day offsets: 0–2600 inclusive. A positive task may finish at 2600.</li></ul><p>Invalid edits or files leave the valid source, schedule and undo history intact. Delete a task with dependents only by explicitly removing its edges. An assigned resource cannot be deleted.</p><h3>Save explicitly</h3><p>Everything lives in document memory. Fresh loads and Reset restore Studio Launch; Reset clears history. Files provides downloads and a file picker / text import. No accounts, network, browser storage or clipboard permission are required.</p></div><div class="dialog-foot"><button class="btn primary" data-action="close-dialog">Got it</button></div>`);}
function importPlan(text){if(new TextEncoder().encode(text).length>C.LIMITS.bytes){dialogError('Import limit is 2 MiB.');return false;}let raw;try{raw=JSON.parse(text);}catch(e){dialogError('JSON could not be parsed: '+e.message);return false;}if(commit(raw,'JSON plan imported; schedule recomputed.',{dialog:true})){if($('#dialog').open)$('#dialog').close();return true;}return false;}
function csv(){const fields=['task_id','task_name','resource_id','resource_name','predecessors','duration','priority','not_before','actual_start_offset','actual_finish_offset','actual_start_date','exclusive_finish_date','last_working_date','dependency_only_earliest_start','dependency_only_earliest_finish','dependency_only_latest_start','dependency_only_latest_finish','dependency_only_total_float'];const quote=v=>/[",\r\n]/.test(String(v))?'"'+String(v).replace(/"/g,'""')+'"':String(v);return [fields,...model.tasks.map(t=>{const a=result.schedule[t.id],c=result.cpm.tasks[t.id];return[t.id,t.name,t.resourceId||'',resource(t.resourceId)?.name||'',t.predecessors.join(';'),t.duration,t.priority,t.notBefore||'',a.start,a.finish,date(a.start),date(a.finish),t.duration?date(a.finish-1):'',c.es,c.ef,c.ls,c.lf,c.float];})].map(row=>row.map(quote).join(',')).join('\r\n')+'\r\n';}
function download(type){const slug=model.project.name.toLowerCase().replace(/[^a-z0-9_-]+/g,'-').replace(/^-|-$/g,'')||'project';let content,mime,extension;if(type==='json'){content=JSON.stringify(model,null,2)+'\n';mime='application/json';extension='json';}if(type==='csv'){content=csv();mime='text/csv;charset=utf-8';extension='csv';}if(type==='svg'){content='<?xml version="1.0" encoding="UTF-8"?>\n'+timelineSVG(result,Math.max(8,Math.min(56,1200/Math.max(12,result.completion+3))),true);mime='image/svg+xml;charset=utf-8';extension='svg';}const blob=new Blob([content],{type:mime}),url=URL.createObjectURL(blob),a=document.createElement('a');a.href=url;a.download=slug+'.'+extension;document.body.append(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(url),2000);notice(extension.toUpperCase()+' exported from the current plan.');}
function previewDrag(event){if(!drag)return;const delta=Math.round((event.clientX-drag.pointerX)/dayWidth);if(!drag.active&&Math.abs(event.clientX-drag.pointerX)<5)return;drag.active=true;const requested=Math.max(0,drag.initialStart+delta);if(drag.requested===requested)return;drag.requested=requested;const previewEl=$('#drag-preview');previewEl.className='preview show';try{const next=clone(model),t=next.tasks.find(t=>t.id===drag.id);t.notBefore=C.workDate(model.project.startDate,requested);const computed=C.compute(next);drag.proposed=next;drag.result=computed;drag.valid=true;renderTimeline(computed);previewEl.textContent=`${drag.id}: requested not before ${t.notBefore} (offset ${requested}). Recalculated start: ${computed.schedule[drag.id].start}; completion: ${computed.completion}. Release to apply · Escape to cancel.`;}catch(e){drag.valid=false;drag.proposed=null;renderTimeline();previewEl.className='preview show error';previewEl.textContent='Invalid preview. '+e.message+' Release or Escape to cancel.';}}
function cancelDrag(){if(!drag)return;drag=null;$('#drag-preview').className='preview';renderTimeline();notice('Drag canceled. Source and history unchanged.');}
function finishDrag(){if(!drag)return;const d=drag;drag=null;$('#drag-preview').className='preview';if(d.active){if(d.valid&&d.proposed)commit(d.proposed,`${d.id} not-before constraint set to ${C.workDate(model.project.startDate,d.requested)}.`,{selected:d.id});else{renderTimeline();notice('Drag was not applied. The requested boundary is outside the supported schedule.',true);}}else setSelection(d.id,true);}
function zoom(delta){const el=$('#timeline-viewport'),old=dayWidth,scroll=el.scrollLeft;dayWidth=Math.max(20,Math.min(112,dayWidth+delta));renderTimeline();el.scrollLeft=scroll/old*dayWidth;}
function action(name){switch(name){case'undo':history('undo');break;case'redo':history('redo');break;case'reset':reset();break;case'files':filesDialog();break;case'help':helpDialog();break;case'project':projectDialog();break;case'manage-resources':resourcesDialog();break;case'new-task':newTask();break;case'new-milestone':newTask(true);break;case'close-dialog':$('#dialog').close();break;case'dismiss-status':$('#status').className='status';break;case'delete-task':deleteTaskDialog();break;case'confirm-delete-task':{const id=selected;if(mutate(m=>{m.tasks=m.tasks.filter(t=>t.id!==id);m.tasks.forEach(t=>t.predecessors=t.predecessors.filter(p=>p!==id));},id+' deleted and its dependency edges removed.',{dialog:true}))$('#dialog').close();break;}case'clear-constraint':if(task())mutate(m=>m.tasks.find(t=>t.id===selected).notBefore=null,'Date constraint cleared.');break;case'export-json':download('json');break;case'export-csv':download('csv');break;case'export-svg':download('svg');break;case'zoom-in':zoom(12);break;case'zoom-out':zoom(-12);break;case'fit':{dayWidth=Math.max(20,Math.min(112,Math.floor(($('#timeline-viewport').clientWidth-20)/Math.max(12,result.completion+3))));renderTimeline();$('#timeline-viewport').scrollLeft=0;break;}case'pan-left':$('#timeline-viewport').scrollLeft-=dayWidth*4;break;case'pan-right':$('#timeline-viewport').scrollLeft+=dayWidth*4;break;case'resource-earlier':resourceStart=Math.max(0,resourceStart-14);renderResources();break;case'resource-later':resourceStart=Math.min(2587,resourceStart+14);renderResources();break;case'add-resource':{readResourceDraft();const f=$('#resources-form'),r={id:f.elements.newId.value,name:f.elements.newName.value,capacity:num(f.elements.newCapacity.value)},p=clone(model);p.resources=[...draftResources,r];try{C.compute(p);draftResources.push(r);paintResourceDialog();}catch(e){dialogError(e.message);}break;}}}
document.addEventListener('click',event=>{const e=event.target.closest('[data-action],[data-view],[data-task],[data-delete-resource]');if(!e)return;if(e.dataset.action){action(e.dataset.action);return;}if(e.dataset.view){setView(e.dataset.view);return;}if(e.dataset.deleteResource){const id=e.dataset.deleteResource,inUse=model.tasks.filter(t=>t.resourceId===id);if(inUse.length){dialogError('Resource '+id+' is assigned to '+inUse.map(t=>t.id).join(', ')+'. Reassign or delete those tasks before deleting it.');return;}readResourceDraft();draftResources=draftResources.filter(r=>r.id!==id);paintResourceDialog();return;}if(e.dataset.task&&!e.classList.contains('gantt-bar'))setSelection(e.dataset.task,true);});
document.addEventListener('change',event=>{const e=event.target;if(e.id==='critical-toggle'){critical=e.checked;renderTimeline();renderResources();}else if(e.id==='task-order'){tableOrder=e.value;renderTable();renderTimeline();}else if(e.dataset.inline){const key=e.dataset.inline,id=e.dataset.id,value=(key==='duration'||key==='priority')?num(e.value):key==='resourceId'?e.value||null:e.value;mutate(m=>m.tasks.find(t=>t.id===id)[key]=value,id+' '+key+' updated.');}else if(e.dataset.capacity){mutate(m=>m.resources.find(r=>r.id===e.dataset.capacity).capacity=num(e.value),e.dataset.capacity+' capacity updated.');}else if(e.id==='edit-date-picker'){$('#edit-not-before').value=e.value;}else if(e.dataset.dependency){const values=Array.from(document.querySelectorAll('[data-dependency]:checked')).map(x=>x.dataset.dependency);$('#edit-predecessors').value=values.join(', ');}else if(e.id==='edit-predecessors'){const values=e.value.split(',').map(p=>p.trim()).filter(Boolean);document.querySelectorAll('[data-dependency]').forEach(x=>x.checked=values.includes(x.dataset.dependency));}else if(e.id==='import-file'){const f=e.files[0];if(!f)return;if(f.size>C.LIMITS.bytes){dialogError('Import limit is 2 MiB.');return;}f.text().then(importPlan).catch(err=>dialogError('Could not read the file: '+err.message));}});
document.addEventListener('submit',event=>{event.preventDefault();const f=event.target,values=Object.fromEntries(new FormData(f)),preds=s=>(s||'').split(',').map(x=>x.trim()).filter(Boolean);if(f.id==='task-edit-form'){const id=selected;mutate(m=>Object.assign(m.tasks.find(t=>t.id===id),{name:values.name,duration:num(values.duration),priority:num(values.priority),resourceId:values.resourceId||null,predecessors:preds(values.predecessors),notBefore:values.notBefore.trim()||null}),id+' updated.');}else if(f.id==='new-task-form'){const t={id:values.id,name:values.name,duration:num(values.duration),priority:num(values.priority),resourceId:values.resourceId||null,predecessors:preds(values.predecessors),notBefore:values.notBefore.trim()||null};if(mutate(m=>m.tasks.push(t),t.id+' created.',{selected:t.id,dialog:true})){$('#dialog').close();if(innerWidth<=700)setView('details');}}else if(f.id==='project-form'){if(mutate(m=>m.project={name:values.name,startDate:values.startDate.trim()},'Project settings updated.',{dialog:true}))$('#dialog').close();}else if(f.id==='resources-form'){readResourceDraft();if(mutate(m=>m.resources=clone(draftResources),'Resources updated.',{dialog:true}))$('#dialog').close();}else if(f.id==='import-form')importPlan(values.json);});
document.addEventListener('pointerdown',event=>{const e=event.target.closest('.gantt-bar');if(!e||event.button!==0||$('#dialog').open)return;event.preventDefault();setSelection(e.dataset.task);drag={id:e.dataset.task,pointerX:event.clientX,initialStart:result.schedule[e.dataset.task].start,requested:null,active:false,valid:false};});
document.addEventListener('pointermove',previewDrag);document.addEventListener('pointerup',finishDrag);document.addEventListener('pointercancel',cancelDrag);
document.addEventListener('keydown',event=>{if(event.key==='Escape'&&drag){event.preventDefault();cancelDrag();return;}const target=event.target;if((event.key==='Enter'||event.key===' ')&&target.classList?.contains('gantt-bar')){event.preventDefault();setSelection(target.dataset.task,true);}const input=target.closest?.('input,textarea,select,[contenteditable]');if((event.ctrlKey||event.metaKey)&&event.key.toLowerCase()==='z'&&!input&&!$('#dialog').open){event.preventDefault();history(event.shiftKey?'redo':'undo');}if((event.ctrlKey||event.metaKey)&&event.key.toLowerCase()==='y'&&!input&&!$('#dialog').open){event.preventDefault();history('redo');}});
let previousNarrow=innerWidth<=700;addEventListener('resize',()=>{const narrow=innerWidth<=700;if(narrow!==previousNarrow){previousNarrow=narrow;renderViews();}});
$('#undo').innerHTML=icon('undo');$('#redo').innerHTML=icon('redo');$('#files').innerHTML=icon('folder',15)+' Files';$('#new-task').innerHTML=icon('plus',14)+' <span class="new-label">New task</span>';$('#policy-icon').innerHTML=icon('info',17);for(const [actionName,iconName] of [['pan-left','chevronLeft'],['pan-right','chevronRight'],['zoom-out','minus'],['zoom-in','plus'],['resource-earlier','chevronLeft'],['resource-later','chevronRight']])document.querySelector(`[data-action="${actionName}"]`).innerHTML=icon(iconName,13);document.querySelectorAll('[data-view]').forEach(e=>{const v=e.dataset.view;e.innerHTML=icon(v==='gantt'?'gantt':v==='tasks'?'tasks':v==='resources'?'resources':'details',e.closest('.mobile-nav')?18:13)+' '+v[0].toUpperCase()+v.slice(1);});
globalThis.PlanningStudio={snapshot:()=>clone({model,schedule:result.schedule,cpm:result.cpm,completion:result.completion,selected,undoCount:undo.length,redoCount:redo.length,view,preview:drag&&{id:drag.id,requested:drag.requested,valid:drag.valid,active:drag.active,schedule:drag.result?.schedule}})};
renderAll();
})();
</script>
