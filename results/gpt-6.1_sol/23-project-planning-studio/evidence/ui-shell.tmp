elected{background:#2c6654;color:white;border-color:#2c6654}.resource-slot.critical{background:#eee6fa;border-color:#d3c6e6;color:#8766aa}.resource-slot.critical.selected{background:var(--purple);color:white}.unassigned{padding:16px;font-size:10px;color:var(--muted);line-height:1.8}.unassigned strong{font-size:11px;color:#6d805e;display:block;margin-bottom:8px}.chip{display:inline-flex;gap:5px;align-items:center;border:1px solid var(--line);border-radius:5px;padding:5px 8px;font-size:10px;background:white;margin:3px;color:#7c8f6a}.chip.selected{background:#e4efdc;border-color:#b8d0a9}.footer{margin-top:24px;display:flex;align-items:center;justify-content:space-between;gap:15px;font-size:10px;color:#8c9785;line-height:1.8}.footer .session-note{display:flex;align-items:center;gap:7px}.footer button{border:0;background:none;font-size:10px;color:#809472;padding:0;text-decoration:underline;text-underline-offset:3px}dialog{border:1px solid var(--line);border-radius:14px;padding:0;max-width:590px;width:calc(100% - 32px);color:var(--ink);box-shadow:0 25px 85px #152d2440;max-height:90dvh;overflow:auto}dialog::backdrop{background:#263a325c;backdrop-filter:blur(3px)}.dialog-head{padding:20px 22px;display:flex;align-items:center;justify-content:space-between;gap:10px;border-bottom:1px solid var(--line)}.dialog-head h2{font-size:18px;font-weight:600;letter-spacing:-.5px;margin:0}.dialog-body{padding:21px 22px}.dialog-body p{font-size:12px;line-height:1.7;color:var(--muted)}.dialog-body h3{font-size:12px;font-weight:600;margin:18px 0 10px}.dialog-body .field>span{font-size:11px}.dialog-body .input{font-size:13px}.dialog-foot{padding:15px 22px;border-top:1px solid var(--line);display:flex;justify-content:flex-end;gap:9px;background:#fafbf8}.dialog-error{display:none;background:#fff0eb;color:#a0503e;border:1px solid #eed1c7;font-size:12px;line-height:1.6;padding:11px;border-radius:7px;margin-bottom:15px;white-space:pre-line}.dialog-error.show{display:block}.export-buttons{display:g