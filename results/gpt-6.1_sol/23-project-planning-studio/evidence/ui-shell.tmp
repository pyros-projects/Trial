<style>
:root{--bg:#f5f6f3;--paper:#fff;--ink:#253a35;--muted:#78837e;--line:#e4e8e2;--green:#2c6654;--mint:#d3eadb;--mint-dark:#b4d9c2;--amber:#a97325;--amber-bg:#fff4dc;--purple:#826baf;--purple-bg:#eee8f8;--shadow:0 3px 15px #243d3210;--radius:13px;font-family:Inter,ui-sans-serif,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:var(--ink);background:var(--bg);font-synthesis:none}*{box-sizing:border-box}body{margin:0}button,input,select,textarea{font:inherit}button{cursor:pointer}button:disabled{cursor:default;opacity:.38}button,input,select,textarea{outline-offset:3px}button:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible,[tabindex]:focus-visible{outline:2px solid var(--green)}button{color:inherit}svg{vertical-align:middle}a{color:var(--green)}.topbar{height:72px;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;padding:0 32px;background:#fff}.brand{display:flex;gap:12px;align-items:center}.brand-mark{width:36px;height:36px;border-radius:10px;background:var(--ink);display:grid;place-items:center;color:#c4e6ce}.brand-name{font-size:15px;font-weight:700;letter-spacing:-.35px}.brand-name span{color:var(--muted);font-weight:400}.top-right{display:flex;gap:20px;align-items:center}.local-badge{display:flex;align-items:center;gap:7px;color:var(--muted);font-size:12px}.dot{width:6px;height:6px;background:#76a382;border-radius:50%;display:inline-block}.quiet-btn{border:0;background:none;padding:7px 9px;border-radius:6px;font-size:12px}.quiet-btn:hover{background:#f1f4ef}.app{max-width:1540px;margin:auto;padding:29px 32px 20px}.project-heading{display:flex;align-items:center;justify-content:space-between;gap:18px;margin-bottom:24px}.eyebrow{font-size:10px;letter-spacing:1.55px;text-transform:uppercase;color:var(--muted);font-weight:650}.crumb{display:flex;align-items:center;gap:8px;margin-bottom:8px}.crumb span:last-child{color:var(--green)}h1{font-size:30px;line-height:1.25;letter-spacing:-1