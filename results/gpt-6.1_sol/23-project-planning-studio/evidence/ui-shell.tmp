legend-items{display:flex;align-items:center;gap:14px;flex-wrap:wrap}.legend-item{display:flex;align-items:center;gap:5px}.swatch{width:9px;height:9px;border-radius:2px;background:var(--mint-dark)}.swatch.purple{background:var(--purple)}.swatch.amber{background:#f1c879}.swatch.diamond{width:7px;height:7px;background:#718e79;transform:rotate(45deg);border-radius:1px}.preview{display:none;border-bottom:1px solid #e3cb91;padding:10px 15px;background:var(--amber-bg);color:#916c26;font-size:11px;line-height:1.5}.preview.show{display:block}.preview.error{color:#a64536;background:#ffefeb}.plan-note{display:flex;align-items:start;gap:11px;margin-top:18px;padding:16px 18px;background:#eef1e9;border-radius:10px;color:#7a8574;font-size:11px;line-height:1.7}.plan-note svg{flex:none;margin-top:3px;color:#839377}.plan-note strong{display:block;color:#5c725b;font-size:11px;font-weight:600;margin-bottom:3px}.plan-note button{border:0;background:none;padding:0;color:var(--green);font-size:11px;text-decoration:underline;text-underline-offset:3px}.resource-strip{display:flex;align-items:center;justify-content:space-between;padding:17px 19px;margin-top:18px;gap:10px}.resource-strip .strip-title{font-size:12px;font-weight:550}.strip-resources{display:flex;align-items:center;gap:21px}.strip-resource{display:flex;align-items:center;gap:8px;font-size:11px}.resource-avatar{width:28px;height:28px;border-radius:7px;background:#e4eee1;color:#6d8a68;display:grid;place-items:center;font-size:10px;font-weight:650}.resource-avatar.review{background:#ebe9f3;color:#8a81a2}.strip-resource small{display:block;font-size:9px;color:var(--muted);margin-top:2px}.strip-link{font-size:10px;background:none;border:0;color:var(--green);display:flex;gap:5px;align-items:center}.inspector{overflow:hidden}.inspector-head{padding:17px 18px 14px;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between}.inspector-head .task-id-pill{font-size:10px;border:1px solid #dfe5d9;border