ose-status{background:none;border:0;padding:0;color:inherit}.workspace{display:grid;grid-template-columns:minmax(0,1fr) 316px;gap:20px;align-items:start}.workspace-main{min-width:0}.panel{border:1px solid var(--line);border-radius:var(--radius);background:white;overflow:hidden;box-shadow:0 2px 6px #263b2b03}.view-toolbar{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:13px 16px;border-bottom:1px solid var(--line);min-height:64px}.view-tabs{display:flex;align-items:center;gap:3px;background:#f3f5f0;padding:4px;border-radius:8px}.view-tab{font-size:11px;font-weight:550;border:0;border-radius:5px;background:none;padding:7px 10px;display:flex;align-items:center;gap:6px;color:#7a867a}.view-tab.active{background:white;color:var(--ink);box-shadow:0 1px 3px #172e1c14}.details-tab{display:none}.toolbar-tools{display:flex;align-items:center;gap:12px}.critical-toggle{display:flex;gap:7px;align-items:center;font-size:11px;white-space:nowrap;cursor:pointer}.critical-toggle input{appearance:none;width:25px;height:14px;margin:0;border-radius:9px;background:#d8ded6;position:relative;cursor:pointer}.critical-toggle input:before{content:"";position:absolute;width:10px;height:10px;border-radius:100%;background:white;left:2px;top:2px;transition:.15s}.critical-toggle input:checked{background:var(--purple)}.critical-toggle input:checked:before{left:13px}.timeline-tools{display:flex;align-items:center;justify-content:space-between;padding:13px 16px;font-size:11px;color:var(--muted);border-bottom:1px solid var(--line)}.timeline-title{font-weight:550;color:var(--ink)}.timeline-sub{color:var(--muted);font-weight:400;margin-left:8px}.zoom-tools{display:flex;align-items:center;gap:3px}.zoom-tools button{border:0;padding:5px;background:transparent;border-radius:4px;font-size:11px}.zoom-tools button:hover{background:#eef3e9}.zoom-readout{min-width:35px;text-align:center;font-size:10px;color:var(--muted)}.timeline-body{display:grid;grid-template-columns:199px minmax