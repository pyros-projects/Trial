function renderWave(){const svg=$('#waveform'),wrap=$('#wave-wrap');if(!svg)return;const probes=C.probes||[],samples=engine.samples,baseTime=samples[0]?.time||0,scale=waveZoom/3,lastTime=samples.at(-1)?.time??baseTime;const end=14+(lastTime-baseTime)*scale+Math.max(12,scale),w=Math.max(wrap.clientWidth,end+22),h=Math.max(145,23+probes.length*31),at=s=>14+(s.time-baseTime)*scale;svg.setAttribute('width',w);svg.setAttribute('height',h);svg.style.height=h+'px';svg.setAttribute('viewBox',`0 0 ${w} ${h}`);svg.dataset.timeOrigin=baseTime;svg.dataset.pixelsPerUnit=scale;$('#probe-labels').innerHTML=probes.map(p=>{const n=engine.nodes.get(p.node),pd=portDefs(n).find(q=>q.name===p.port),v=engine.read(p.node,p.port);return `<div class="probe-row"><span class="port-dot" style="background:${colors[p.color%6]}"></span><span title="${esc(n.label+'.'+p.port)}">${esc(p.name)}</span><span class="probeval">${esc(fmt(v,pd.width))}</span><button data-remove-probe="${p.id}" aria-label="Remove probe ${esc(p.name)}">×</button></div>`;}).join('');let html='';const gridStep=Math.max(1,Math.ceil(45/scale));for(let t=Math.ceil(baseTime/gridStep)*gridStep;t<=baseTime+w/scale;t+=gridStep){const x=14+(t-baseTime)*scale;html+=`<path class="wave-grid" d="M${x} 21V${h}"/><text x="${x+2}" y="13" class="wave-label">${t}</text>`;}for(let i=0;i<probes.length;i++){const p=probes[i],n=engine.nodes.get(p.node),pd=portDefs(n).find(q=>q.name===p.port),top=26+i*31,base=top+20,col=colors[p.color%6];html+=`<path class="wave-grid" d="M0 ${top+28}H${w}"/>`;let path='',prev=null;for(let j=0;j<samples.length;j++){const s=samples[j],v=s.values[p.id]??'X',x=at(s),x2=j===samples.length-1?end:at(samples[j+1]);const y=known(v)?v?top+4:base:top+12;if(pd.width===1){if(!known(v)){if(path){html+=`<path d="${path}" class="wave-trace" stroke="${col}"/>`;path='';}html+=`<path d="M${x} ${y}H${x2}" stroke="var(--unknown)" stroke-width="1.4" stroke-dasharray="3 2"/><text x="${x+3}" y="${top+9}" class="wave-label" style="fill:var(--unknown)">${v}</text>`;prev=null;}else{path+=!path?`M${x},${y}`:prev!==y?`V${y}`:'';path+=`H${x2}`;prev=y;}}else{const corner=Math.min(4,(x2-x)/2);html+=`<path d="M${x} ${top+12}l${corner} -8H${x2-corner}l${corner} 8-${corner} 8H${x+corner}z" fill="${col}09" stroke="${known(v)?col:'var(--unknown)'}" stroke-width="1.2"/>`;if(x2-x>22)html+=`<text x="${(x+x2)/2}" y="${top+15}" text-anchor="middle" style="font:9px var(--mono);fill:${col}">${esc(fmt(v,pd.width))}</text>`;}}if(path)html+=`<path d="${path}" class="wave-trace" stroke="${col}"/>`;}html+=`<path d="M${end} 20V${h}" stroke="var(--line)" stroke-dasharray="3 3"/>`;if(samples.length<2&&probes.length)html+=`<text x="${Math.min(92,w/4)}" y="${h/2}" class="wave-label">Toggle an input or step the clock to capture.</text>`;if(!probes.length)html+=`<text x="20" y="65" class="wave-label">Add a probe to capture a live signal.</text>`;if(waveCursor!==null)html+=`<path d="M${waveCursor} 20V${h}" stroke="var(--ink)" stroke-width="1" stroke-dasharray="3 3"/>`;svg.innerHTML=html;$('#sample-count').textContent=samples.length+' sample'+(samples.length===1?'':'s');if(running)wrap.scrollLeft=w;}
