(()=>{
'use strict';
const {Engine,TYPES,SEQ,SOURCE,makeNode,portDefs,preset,validateCircuit,mask,known}=Logic;
const $=s=>document.querySelector(s),$$=s=>Array.from(document.querySelectorAll(s)),esc=s=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const icons={chip:'M6 6h12v12H6z M9 9h6v6H9z M9 3v3m6-3v3M9 18v3m6-3v3M3 9h3m-3 6h3m12-6h3m-3 6h3',arrow:'m6 3 12 9-7 1-3 7z',hand:'M8 11V6a2 2 0 0 1 4 0v5-7a2 2 0 0 1 4 0v7-4a2 2 0 0 1 4 0v8c0 5-3 7-7 7-3 0-5-2-7-5l-3-5a2 2 0 0 1 3-2l2 2',wire:'M4 6h6v12h10 M4 4v4m16 8v4',probe:'m5 19 8-8m-4-2 6 6m-3-9 6 6m-2-8 4 4M3 21l3-1-2-2z',undo:'M8 5 3 10l5 5M3 10h11a6 6 0 0 1 0 12',redo:'m16 5 5 5-5 5m5-5H10a6 6 0 0 0 0 12',play:'m8 4 12 8-12 8z',pause:'M8 4v16M16 4v16',step:'m5 5 10 7-10 7zM19 5v14',event:'m13 2-9 12h7l-1 8 10-13h-8z',reset:'M4 10a8 8 0 1 1 1 8M4 4v6h6',search:'M10 17a7 7 0 1 0 0-14 7 7 0 0 0 0 14m5-2 6 6',grid:'M3 3h7v7H3zM14 3h7v7h-7zM3 14h7v7H3zM14 14h7v7h-7z',folder:'M3 6h7l2 3h9v11H3z',download:'M12 3v12m-5-5 5 5 5-5M4 16v5h16v-5',upload:'M12 16V4m-5 5 5-5 5 5M4 17v4h16v-4',share:'M8 11 16 6m-8 7 8 5M5 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6m14-6a3 3 0 1 0 0-6 3 3 0 0 0 0 6m0 12a3 3 0 1 0 0-6 3 3 0 0 0 0 6',settings:'M12 8a4 4 0 1 0 0 8 4 4 0 0 0 0-8M10 2h4l1 4 3 1 3-1 2 4-3 3v2l2 3-3 3-3-2-3 1-1 3H9l-1-3-3-1-3 1-2-4 3-3v-2L1 8l3-3 3 2 3-1z',help:'M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20m-3-14a3 3 0 1 1 4 3c-1 0-1 1-1 3m0 3h.01',chevron:'m8 4 8 8-8 8',down:'m6 9 6 6 6-6',close:'m6 6 12 12M6 18 18 6',plus:'M12 5v14M5 12h14',minus:'M5 12h14',fit:'M8 3H3v5m13-5h5v5M3 16v5h5m13-5v5h-5M8 8h8v8H8z',info:'M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20m0-12v7m0-11h.01',wave:'M2 17h4V7h5v10h5V7h6',table:'M3 4h18v16H3zM3 9h18M9 4v16m6-16v16M3 14h18',save:'M4 3h13l4 4v14H3V3zm3 0v7h10V3M7 21v-7h10v7',copy:'M8 8h13v13H8zM16 8V3H3v13h5',trash:'M4 6h16M9 6V3h6v3M6 6l1 15h10l1-15M10 10v7m4-7v7',check:'m5 12 5 5 10-11',code:'m8 6-6 6 6 6m8-12 6 6-6 6',layers:'m12 3 10 6-10 6L2 9zm-10 10 10 6 10-6m-20 5 10 6 10-6',clock:'M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20m0-16v6l4 3',book:'M3 3h7l2 2 2-2h7v17h-7l-2 2-2-2H3zm9 2v17',bolt:'m13 2-9 12h7l-1 8 10-13h-8z'};
const icon=name=>`<svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="${icons[name]||icons.chip}"/></svg>`;
const button=(id,name,ic,cls='')=>`<button id="${id}" class="${cls}" title="${esc(name)}" aria-label="${esc(name)}">${ic?icon(ic):''}</button>`;
let settings={speed:2,delay:'unit',limit:4096,bits:1,grid:true,snap:true,wire:'smooth',radix:'bin',theme:'light',animation:true,overlay:'values',contrast:false};
try{const saved=JSON.parse(localStorage.getItem('bitwise-settings')||'null');if(saved)Object.assign(settings,saved);}catch{}
let C=preset('half'),engine,selection=new Set(),selectedWire=null,tool='select',connection=null,view={x:0,y:0,z:1},undoStack=[],redoStack=[],clipboard=null,running=false,timer=null,recording=true,waveZoom=34,waveCursor=null,drag=null,dirty=true,fps=60,frameCount=0,lastFPS=performance.now(),lastPaint=0,toastTimer,saveTimer,projectId=null,modalKind=null,inspectKey='',wireID=Date.now();
try{const saved=localStorage.getItem('bitwise-autosave');if(saved){const parsed=JSON.parse(saved);C=validateCircuit(parsed.circuit||parsed);projectId=parsed.projectId||null;}}catch{}
engine=new Engine(C,{limit:settings.limit,delay:settings.delay});C=engine.circuit;
const colors=['#29a589','#658caf','#9073c4','#c29b51','#ce6f89','#6f9f68'];
const fmt=(v,b=1,radix=settings.radix)=>!known(v)?v:radix==='hex'?(b>1?'0x':'')+v.toString(16).toUpperCase().padStart(Math.ceil(b/4),'0'):radix==='dec'?String(v):v.toString(2).padStart(b,'0');
const signalClass=v=>v==='X'?'unknown':v==='Z'?'floating':v===0?'low':'high';
function dims(n){return {w:['CONTROL','RAM','ROM'].includes(n.type)?132:112,h:Math.max(86,Math.max(portDefs(n).filter(p=>p.dir==='in').length,portDefs(n).filter(p=>p.dir==='out').length)*23+18)};}
function portPosition(n,name){const p=portDefs(n).find(p=>p.name===name);if(!p)return {x:n.x,y:n.y};const same=portDefs(n).filter(q=>q.dir===p.dir),d=dims(n);return {x:n.x+(p.dir==='out'?d.w:0),y:n.y+(same.length===1?d.h/2:20+same.indexOf(p)*(d.h-40)/(same.length-1))};}
function bounds(){if(!C.nodes.length)return {x:0,y:0,w:800,h:500};const minX=Math.min(...C.nodes.map(n=>n.x)),minY=Math.min(...C.nodes.map(n=>n.y-25));const maxX=Math.max(...C.nodes.map(n=>n.x+dims(n).w)),maxY=Math.max(...C.nodes.map(n=>n.y+dims(n).h+20));return {x:minX,y:minY,w:maxX-minX,h:maxY-minY};}
function mount(){ $('#app').innerHTML=`
<header class="topbar"><div class="brand"><div class="brandmark">${icon('chip')}</div><div><div class="brandname">bitwise<span style="color:var(--green)">.</span></div><small>DIGITAL LOGIC LAB</small></div></div><div class="project-nav">Workspace ${icon('chevron')} <b id="project-nav-name">Half adder</b><span class="pill">Local</span></div><div class="spacer"></div><span class="saved" id="saved-status"><i></i>All changes saved</span><button id="projects-btn" class="textbtn top-action">${icon('folder')}Projects</button><button id="examples-btn" class="textbtn top-action">${icon('book')}Examples</button><button id="export-btn" class="top-action">${icon('share')}Export</button>${button('help-btn','Keyboard shortcuts and guide','help','textbtn iconbtn help-button')}<div class="avatar" title="Everything stays on your device">BW</div></header>
<nav class="commandbar" aria-label="Circuit tools">${button('palette-btn','Components','grid','mobile-only tool')}<div style="display:flex;gap:3px">${button('select-tool','Select (V)','arrow','tool active')}${button('pan-tool','Pan (H)','hand','tool')}${button('wire-tool','Connect wire (W)','wire','tool')}${button('probe-tool','Add probe (P)','probe','tool hide-small')}</div><div class="divider"></div>${button('undo-btn','Undo (Ctrl+Z)','undo','tool')}${button('redo-btn','Redo (Ctrl+Shift+Z)','redo','tool')}<div class="divider"></div><button id="run-btn" class="primary run-button">${icon('play')}<span>Run</span><span class="keycap desktop-only" style="background:#ffffff15;color:#e1f8eb;border-color:#ffffff30">Space</span></button><button id="tick-btn" title="Advance one clock tick (T)">${icon('step')}<span class="desktop-only">Step</span></button>${button('event-btn','Step one propagation event (E)','event','textbtn hide-small')}${button('reset-btn','Reset simulation (R)','reset','textbtn')}<div class="divider hide-small"></div><label class="muted hide-small" style="font-size:11px">Clock</label><select id="clock-speed" aria-label="Clock speed"><option value="0.5">0.5 Hz</option><option value="1">1 Hz</option><option value="2">2 Hz</option><option value="5">5 Hz</option><option value="10">10 Hz</option><option value="20">20 Hz</option><option value="60">60 Hz</option></select><div class="spacer"></div><button id="truth-btn" class="textbtn desktop-only">${icon('table')}Truth table</button>${button('settings-btn','Lab settings','settings','textbtn')}${button('inspector-btn','Toggle inspector','info','textbtn mobile-only')}</nav>
<div class="workspace-layout"><aside class="palette" aria-label="Component palette"><div class="panelheading">Components <span class="spacer"></span><span class="eyebrow">${Object.keys(TYPES).length}</span>${button('palette-close','Close components','close','textbtn small mobile-only')}</div><div class="searchbox">${icon('search')}<input id="component-search" type="search" placeholder="Find a component…" aria-label="Search components"><span class="keycap">/</span></div><div id="palette-list" class="palette-list"></div><div class="palette-foot"><span>Small parts. Endless possibilities.</span>Click to add · Drag to place</div></aside>
<main class="center"><section class="workspace" aria-label="Circuit workspace"><div class="canvas-heading"><div class="eyebrow">EXPERIMENT <span id="experiment-number">01</span> / <span id="circuit-kind">COMBINATIONAL LOGIC</span></div><h1><span id="circuit-name">Half adder</span><span class="pill" id="circuit-width">1-bit</span></h1><p id="circuit-description"></p></div><div class="canvas-topright">${button('overview-btn','Circuit inspector','info','iconbtn')}</div><div class="live-badge"><span><b id="workspace-state">●</b> <span id="workspace-state-name">Simulation ready</span></span><span id="workspace-tick">tick 0</span></div><svg id="circuit" role="application" aria-label="Interactive circuit editor" tabindex="0" xmlns="http://www.w3.org/2000/svg"><defs><pattern id="dots" width="20" height="20" patternUnits="userSpaceOnUse"><circle cx="1" cy="1" r=".8" fill="#c9d4da"/></pattern><filter id="nodeShadow" x="-20%" y="-20%" width="140%" height="160%"><feDropShadow dx="0" dy="3" stdDeviation="3" flood-color="#17382a" flood-opacity=".035"/></filter><filter id="ledGlow"><feGaussianBlur stdDeviation="2" result="b"/><feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge></filter></defs><rect id="grid-background" width="100%" height="100%" fill="url(#dots)"/><g id="world"><g id="wires"></g><g id="nodes"></g><g id="guides"></g><path id="draft-wire" class="wire-line high" stroke-dasharray="5 4"/><rect id="marquee" class="selection-box" style="display:none"/></g></svg><div class="canvas-bottomleft"><div class="zoomtools">${button('zoom-out','Zoom out','minus')}<span id="zoom-label" class="zoomlabel">100%</span>${button('zoom-in','Zoom in','plus')}<div class="divider" style="height:16px;margin:0 4px"></div>${button('fit-btn','Fit circuit (F)','fit')}</div>${button('grid-btn','Toggle grid','grid','iconbtn desktop-only')}</div><div class="canvas-hint" id="canvas-hint">Click a switch to explore · Connect ports to build</div><svg id="minimap" class="minimap" viewBox="0 0 125 76" aria-label="Circuit minimap" role="img"></svg></section><div id="analyzer-resizer" class="resizer"></div><section class="analyzer" aria-label="Logic analyzer"><header class="analyzer-header"><button id="analyzer-tab" class="tab active">${icon('wave')}Logic analyzer</button><button id="table-tab" class="tab">${icon('table')}Truth table</button><span class="pill"><span class="recorddot"></span><span id="capture-status">LIVE</span></span><div class="spacer"></div><button id="add-probe-btn" class="small textbtn" title="Attach a named probe">${icon('plus')}Add probe</button>${button('wave-minus','Zoom waveform out','minus','textbtn small')}${button('wave-plus','Zoom waveform in','plus','textbtn small')}${button('csv-btn','Export waveform CSV','download','textbtn small')}${button('collapse-analyzer','Collapse analyzer','down','textbtn small')}</header><div class="analyzer-main"><div id="probe-labels" class="probe-labels"></div><div id="wave-wrap" class="wave-wrap"><svg id="waveform" aria-label="Live signal waveforms" xmlns="http://www.w3.org/2000/svg"></svg></div></div><footer class="analyzer-foot"><span id="sample-count">1 sample</span><span>Resolution <b>½ tick</b></span><span class="spacer"></span><span id="wave-readout">Move over a waveform to inspect</span></footer></section></main>
<aside class="inspector" aria-label="Property inspector"><div class="panelheading">Inspector <span class="spacer"></span>${button('close-inspector','Close inspector','close','textbtn small floating-panel-close')}${icon('layers')}</div><div id="inspector-content" class="inspector-content"></div></aside></div>
<footer class="statusbar" aria-label="Live simulation diagnostics"><span id="status-message" class="status-ready">All signals settled</span><span id="status-counts">6 components · 6 wires</span><span id="status-events" class="optional">0 pending</span><span id="status-iterations" class="optional">0 iterations</span><div class="status-right"><span id="status-signal" class="optional">signal —</span><span id="status-fps">60 fps</span><span id="status-clock" class="optional">0 ticks · 2 Hz</span><span id="status-tool">Select</span><span id="status-running">Paused</span></div></footer>`;
$('#clock-speed').value=settings.speed;renderPalette();bind();applySettings();updateTitles();renderInspector();requestAnimationFrame(()=>{fit();renderScene();renderWave();});}
function renderPalette(filter=''){let html='',cat='';for(const [type,d]of Object.entries(TYPES)){if(filter&&!`${d.name} ${d.cat}`.toLowerCase().includes(filter.toLowerCase()))continue;if(cat!==d.cat){cat=d.cat;html+=`<div class="palette-group"><span class="eyebrow">${cat}</span><span class="muted" style="font-size:10px">⌄</span></div>`;}html+=`<button class="component-item" data-add="${type}" draggable="true" title="${esc(d.desc)}" aria-label="Add ${esc(d.name)}"><span class="palette-symbol">${esc(d.symbol)}</span><span>${esc(d.name)}</span><span class="addhint">+</span></button>`;}$('#palette-list').innerHTML=html||'<div class="empty-state">No components found.</div>';}
function updateTitles(){$('#circuit-name').textContent=C.name;$('#project-nav-name').textContent=C.name;$('#circuit-description').textContent=C.description;$('#circuit-kind').textContent=C.nodes.some(n=>n.type==='CONTROL')?'COMPUTER ARCHITECTURE':C.nodes.some(n=>SEQ.has(n.type)||n.type==='LATCH')?'SEQUENTIAL LOGIC':'COMBINATIONAL LOGIC';$('#circuit-width').textContent=Math.max(1,...C.nodes.filter(n=>n.type!=='ROM').map(n=>n.bits))+'-bit';}
function worldPoint(e){const r=$('#circuit').getBoundingClientRect();return {x:(e.clientX-r.left-view.x)/view.z,y:(e.clientY-r.top-view.y)/view.z};}
function applyView(){$('#world').setAttribute('transform',`translate(${view.x} ${view.y}) scale(${view.z})`);$('#dots').setAttribute('patternTransform',`translate(${view.x} ${view.y}) scale(${view.z})`);$('#zoom-label').textContent=Math.round(view.z*100)+'%';renderMini();}
function fit(){const r=$('#circuit').getBoundingClientRect(),b=bounds();const top=r.width<500?133:112,bottom=97;view.z=Math.max(.18,Math.min(1.2,(r.width-100)/(b.w+60),(r.height-top-bottom)/(b.h+20)));if(view.z<.22)view.z=.22;view.x=(r.width-b.w*view.z)/2-b.x*view.z;view.y=top+(Math.max(0,r.height-top-bottom)-b.h*view.z)/2-b.y*view.z;applyView();}
function zoom(factor,client){const r=$('#circuit').getBoundingClientRect();const p=client?{x:client.x-r.left,y:client.y-r.top}:{x:r.width/2,y:r.height/2};const z=Math.max(.15,Math.min(3,view.z*factor));view.x=p.x-(p.x-view.x)*z/view.z;view.y=p.y-(p.y-view.y)*z/view.z;view.z=z;applyView();}
function route(a,b){if(settings.wire==='straight')return `M${a.x},${a.y}L${b.x},${b.y}`;if(b.x<a.x+20){const yy=Math.max(a.y,b.y)+65;return `M${a.x},${a.y}h30 Q${a.x+40},${a.y} ${a.x+40},${a.y+10} V${yy-10} Q${a.x+40},${yy} ${a.x+30},${yy} H${b.x-40} Q${b.x-50},${yy} ${b.x-50},${yy-10} V${b.y+10} Q${b.x-50},${b.y} ${b.x-40},${b.y} H${b.x}`;}if(settings.wire==='orthogonal'){const mid=(a.x+b.x)/2;return `M${a.x},${a.y}H${mid}V${b.y}H${b.x}`;}const d=Math.max(38,(b.x-a.x)*.48);return `M${a.x},${a.y}C${a.x+d},${a.y} ${b.x-d},${b.y} ${b.x},${b.y}`;}
function symbol(n,d){let x=d.w/2,y=d.h/2;const t=n.type;if(['AND','NAND'].includes(t))return `<path class="gate-symbol" d="M${x-17} ${y-18}h15a18 18 0 0 1 0 36h-15z"/>${t==='NAND'?`<circle class="gate-symbol" cx="${x+22}" cy="${y}" r="3"/>`:''}`;if(['OR','NOR','XOR'].includes(t))return `<path class="gate-symbol" d="M${x-21} ${y-18}q24 0 43 18-19 18-43 18 12-18 0-36z"/>${t==='XOR'?`<path class="gate-symbol" d="M${x-27} ${y-18}q12 18 0 36"/>`:t==='NOR'?`<circle class="gate-symbol" cx="${x+27}" cy="${y}" r="3"/>`:''}`;if(['NOT','BUFFER','TRISTATE'].includes(t))return `<path class="gate-symbol" d="M${x-17} ${y-18}l34 18-34 18z"/>${t==='NOT'?`<circle class="gate-symbol" cx="${x+22}" cy="${y}" r="3"/>`:t==='TRISTATE'?`<path class="gate-symbol" d="M${x} ${y+9}v12"/>`:''}`;if(t==='CLOCK')return `<path class="gate-symbol" style="stroke:var(--green)" d="M${x-27} ${y+10}h15v-20h20v20h18"/>`;if(t==='MUX')return `<path class="gate-symbol" d="M${x-19} ${y-23}l34 10v26l-34 10z"/><text x="${x-2}" y="${y+4}" text-anchor="middle" class="node-sublabel">MUX</text>`;return `<text x="${x}" y="${y+5}" text-anchor="middle" class="node-sublabel" style="font-size:${TYPES[t].symbol.length>3?13:19}px;fill:var(--ink)">${esc(TYPES[t].symbol)}</text>`;}
function renderNode(n){const d=dims(n),ports=portDefs(n),v=n.type==='LED'?engine.input(n.id,'A'):engine.output(n.id,ports.find(p=>p.dir==='out')?.name),sc=signalClass(v);let content='';
if(n.type==='SWITCH'||n.type==='BUTTON'){content=`<text x="13" y="19" class="node-sublabel">${n.type==='BUTTON'?'MOMENTARY':n.bits===1?'INPUT':'INPUT BUS'}</text><g role="button" tabindex="0" aria-label="${n.type==='BUTTON'?'Press':'Toggle'} ${esc(n.label)}" data-toggle="${n.id}" class="switch-control ${sc}"><rect class="switch-track" x="15" y="35" width="48" height="25" rx="13"/><circle cx="${v?50:28}" cy="47.5" r="9" fill="white"/><text x="${n.bits>1?74:82}" y="53" class="node-value ${sc}" style="font-size:${n.bits>4?10:n.bits>1?14:20}px" data-node-value="${n.id}">${esc(fmt(v,n.bits))}</text><rect x="8" y="27" width="95" height="40" fill="transparent"/><title>${n.type==='BUTTON'?'Hold to assert high':'Click to '+(n.bits===1?'toggle':'increment')+' · Edit value in inspector'}</title></g>`;}
else if(n.type==='LED'){content=`<text x="13" y="19" class="node-sublabel">${n.bits===1?'OUTPUT':'OUTPUT BUS'}</text><circle cx="33" cy="46" r="9" class="led-light ${sc}" data-led="${n.id}"/><text x="59" y="53" class="node-value ${sc}" style="font-size:${n.bits>4?12:n.bits>1?15:23}px" data-node-value="${n.id}">${esc(fmt(v,n.bits))}</text>`;}
else if(SEQ.has(n.type)||n.type==='CONST'){content=`<text x="${d.w/2}" y="29" text-anchor="middle" class="node-sublabel">${esc(TYPES[n.type].symbol)}</text><text x="${d.w/2}" y="${d.h/2+15}" text-anchor="middle" class="node-value ${sc}" style="font-size:${n.bits>8?11:n.bits>4?14:19}px" data-node-value="${n.id}">${esc(fmt(v,n.bits))}</text>`;}
else content=symbol(n,d);
const phtml=ports.map(p=>{const pos=portPosition(n,p.name),pv=engine.read(n.id,p.name);return `<g class="port ${signalClass(pv)}" tabindex="0" role="button" aria-label="${esc(n.label)} ${p.dir==='in'?'input':'output'} ${p.name} (${p.width} bit${p.width>1?'s':''})" data-node="${n.id}" data-port="${p.name}" data-dir="${p.dir}" transform="translate(${pos.x-n.x} ${pos.y-n.y})"><circle class="port-hit" r="12"/><circle class="port-core" r="4"/><text x="${p.dir==='in'?9:-9}" y="-7" text-anchor="${p.dir==='in'?'start':'end'}" class="port-label">${p.name==='Q'?'':p.name}</text><title>${esc(n.label)}.${p.name} · ${p.width} bit · ${fmt(pv,p.width)}</title></g>`;}).join('');
return `<g class="circuit-node ${selection.has(n.id)?'selected':''}" data-id="${n.id}" transform="translate(${n.x} ${n.y})" role="group" aria-label="${esc(n.label)}: ${TYPES[n.type].name}"><text x="0" y="-12" class="node-label">${esc(n.label)}</text><rect class="node-body" width="${d.w}" height="${d.h}" rx="9"/>${content}<text x="${d.w}" y="${d.h+16}" text-anchor="end" class="node-sublabel">${n.bits} BIT</text>${phtml}${settings.overlay==='order'?`<text x="0" y="${d.h+16}" class="diagnostic-label">eval #${engine.order.lastIndexOf(n.id)+1}</text>`:settings.overlay==='fanout'?`<text x="0" y="${d.h+16}" class="diagnostic-label">fan-out ${ports.filter(p=>p.dir==='out').reduce((s,p)=>s+(engine.fanout.get(n.id+':'+p.name)?.length||0),0)}</text>`:settings.overlay==='loops'&&engine.loops.flat().includes(n.id)?`<rect x="-6" y="-6" width="${d.w+12}" height="${d.h+12}" rx="12" fill="none" stroke="var(--unknown)" stroke-dasharray="4"/>`:settings.overlay==='clocks'&&SEQ.has(n.type)?`<text x="0" y="${d.h+16}" class="diagnostic-label">↑ ${esc((engine.inputs.get(n.id+':CLK')||[]).map(p=>engine.nodes.get(p.node).label).join(', ')||'unclocked')}</text>`:''}</g>`;}
function renderScene(){if(!$('#nodes'))return;$('#nodes').innerHTML=C.nodes.map(renderNode).join('');$('#wires').innerHTML=C.wires.map(w=>{const a=engine.nodes.get(w.from.node),b=engine.nodes.get(w.to.node);if(!a||!b)return'';const pa=portPosition(a,w.from.port),pb=portPosition(b,w.to.port),v=engine.output(a.id,w.from.port),sc=signalClass(v),path=route(pa,pb);const bw=portDefs(a).find(p=>p.name===w.from.port)?.width||1;return `<g data-wire="${w.id}" role="button" tabindex="0" aria-label="Wire ${esc(a.label)} ${w.from.port} to ${esc(b.label)} ${w.to.port}"><path class="wire-hit" d="${path}"/><path class="wire-line ${sc} ${selectedWire===w.id?'selected':''}" d="${path}"/>${v&&known(v)?`<path class="wire-flow" d="${path}"/>`:''}${settings.overlay==='values'&&(bw>1||selectedWire===w.id)?`<text x="${pa.x+16}" y="${pa.y-10}" class="wire-value">${esc(fmt(v,bw))}</text>`:''}<title>${esc(a.label)}.${w.from.port} → ${esc(b.label)}.${w.to.port}: ${fmt(v,bw)}</title></g>`;}).join('');applyView();dirty=false;updateStatus();}
function refreshSignals(){if(drag)return;renderScene();renderInspector(false);renderWave();}
function renderMini(){const el=$('#minimap');if(!el)return;const b=bounds(),pad=10,s=Math.min(105/(b.w+20),56/(b.h+20)),ox=(125-b.w*s)/2,oy=(76-b.h*s)/2;let html=C.wires.map(w=>{const a=engine.nodes.get(w.from.node),t=engine.nodes.get(w.to.node);if(!a||!t)return'';return `<path d="M${ox+(a.x-b.x)*s},${oy+(a.y-b.y)*s}L${ox+(t.x-b.x)*s},${oy+(t.y-b.y)*s}" stroke="var(--low)" stroke-width=".5"/>`;}).join('');html+=C.nodes.map(n=>`<rect x="${ox+(n.x-b.x)*s}" y="${oy+(n.y-b.y)*s}" width="${Math.max(4,dims(n).w*s)}" height="${Math.max(3,dims(n).h*s)}" rx="1" fill="${selection.has(n.id)?'var(--green)':'#c6d8d0'}"/>`).join('');const r=$('#circuit').getBoundingClientRect();html+=`<rect x="${ox+(-view.x/view.z-b.x)*s}" y="${oy+(-view.y/view.z-b.y)*s}" width="${r.width/view.z*s}" height="${r.height/view.z*s}" fill="#159b7809" stroke="var(--green)" stroke-width=".7"/>`;el.innerHTML=html;el._map={b,s,ox,oy};}
function updateStatus(){$('#status-counts').textContent=`${C.nodes.length} components · ${C.wires.length} wires`;$('#status-events').textContent=engine.queue.length+' pending';$('#status-iterations').textContent=engine.iterations+' iterations';$('#status-clock').textContent=engine.ticks+' ticks · '+settings.speed+' Hz';$('#workspace-tick').textContent='tick '+engine.ticks;$('#status-running').textContent=running?'Running':'Paused';$('#status-tool').textContent=tool[0].toUpperCase()+tool.slice(1);$('#status-fps').textContent=fps+' fps';$('#workspace-state-name').textContent=engine.warnings.length?'Check diagnostics':running?'Simulation running':'Simulation ready';$('#status-message').textContent=engine.warnings[0]|| (engine.queue.length?'Propagation pending':'All signals settled');$('#status-message').className=engine.warnings.length?'warn':'status-ready';const id=[...selection][0],n=engine.nodes.get(id);const p=n&&portDefs(n).find(p=>p.dir==='out');$('#status-signal').textContent='signal '+(n?fmt(p?engine.output(id,p.name):engine.input(id,'A'),n.bits):'—');$('#undo-btn').disabled=!undoStack.length;$('#redo-btn').disabled=!redoStack.length;}
function renderWave(){const svg=$('#waveform'),wrap=$('#wave-wrap');if(!svg)return;const probes=C.probes||[],samples=engine.samples;const w=Math.max(wrap.clientWidth,samples.length*waveZoom+40),h=Math.max(145,23+probes.length*31);svg.setAttribute('width',w);svg.setAttribute('height',h);svg.style.height=h+'px';svg.setAttribute('viewBox',`0 0 ${w} ${h}`);$('#probe-labels').innerHTML=probes.map(p=>{const n=engine.nodes.get(p.node),pd=portDefs(n).find(q=>q.name===p.port),v=engine.read(p.node,p.port);return `<div class="probe-row"><span class="port-dot" style="background:${colors[p.color%6]}"></span><span title="${esc(n.label+'.'+p.port)}">${esc(p.name)}</span><span class="probeval">${esc(fmt(v,pd.width))}</span><button data-remove-probe="${p.id}" aria-label="Remove probe ${esc(p.name)}">×</button></div>`;}).join('');let html='';const count=Math.ceil(w/waveZoom);for(let k=0;k<count;k++){const x=k*waveZoom+14;html+=`<path class="wave-grid" d="M${x} 21V${h}"/>`;if(k%2===0){const sm=samples[k];html+=`<text x="${x+2}" y="13" class="wave-label">${sm?sm.tick:k/2}</text>`;}}for(let i=0;i<probes.length;i++){const p=probes[i],n=engine.nodes.get(p.node),pd=portDefs(n).find(q=>q.name===p.port),top=26+i*31,base=top+20,col=colors[p.color%6];html+=`<path class="wave-grid" d="M0 ${top+28}H${w}"/>`;let path='',prev=null;const display=samples.length?samples:[{values:{}}];for(let j=0;j<Math.max(display.length,1);j++){const v=display[j].values[p.id]??'X',x=14+j*waveZoom,x2=j===display.length-1?Math.max(w-10,x+waveZoom):x+waveZoom;const y=known(v)?v?top+4:base:top+12;if(pd.width===1){path+=(j===0?`M${x},${y}`:prev!==y?`V${y}`:'')+`H${x2}`;prev=y;if(!known(v))html+=`<text x="${x+5}" y="${top+16}" class="wave-label" style="fill:var(--unknown)">${v}</text>`;}else{html+=`<path d="M${x} ${top+12}l4 -8H${x2-4}l4 8-4 8H${x+4}z" fill="${col}09" stroke="${known(v)?col:'var(--unknown)'}" stroke-width="1.2"/><text x="${x+waveZoom/2}" y="${top+15}" text-anchor="middle" style="font:9px var(--mono);fill:${col}">${esc(fmt(v,pd.width))}</text>`;}}if(path)html+=`<path d="${path}" class="wave-trace" stroke="${col}"/>`;}if(!probes.length)html+=`<text x="20" y="65" class="wave-label">Add a probe to capture a live signal.</text>`;if(waveCursor!==null)html+=`<path d="M${waveCursor} 20V${h}" stroke="var(--ink)" stroke-width="1" stroke-dasharray="3 3"/>`;svg.innerHTML=html;$('#sample-count').textContent=samples.length+' sample'+(samples.length===1?'':'s');if(running)wrap.scrollLeft=w;}
function record(phase){if(recording)engine.capture(phase);}
function snapshotCircuit(){return JSON.stringify(C);}
function checkpoint(){undoStack.push(snapshotCircuit());if(undoStack.length>80)undoStack.shift();redoStack=[];}
function autosave(){clearTimeout(saveTimer);$('#saved-status').innerHTML='<i></i>Saving…';saveTimer=setTimeout(()=>{try{localStorage.setItem('bitwise-autosave',JSON.stringify({circuit:C,projectId}));localStorage.setItem('bitwise-settings',JSON.stringify(settings));$('#saved-status').innerHTML='<i></i>All changes saved';}catch{$('#saved-status').textContent='Storage unavailable';}},300);}
function rebuild(preserve=true){const old=engine;engine=new Engine(C,{delay:settings.delay,limit:settings.limit});C=engine.circuit;if(preserve&&old){for(const n of C.nodes){const prev=old.nodes.get(n.id);if(prev&&prev.type===n.type&&prev.bits===n.bits){engine.state.set(n.id,JSON.parse(JSON.stringify(old.state.get(n.id))));for(const p of portDefs(n).filter(p=>p.dir==='out'))engine.values.set(n.id+':'+p.name,old.output(n.id,p.name));}engine.enqueue(n.id);}engine.time=old.time;engine.ticks=old.ticks;engine.samples=old.samples;engine.sampleIndex=old.sampleIndex;engine.settle();record('edit');}for(const id of selection)if(!engine.nodes.has(id))selection.delete(id);updateTitles();renderScene();renderInspector();renderWave();autosave();}
function history(redo=false){const src=redo?redoStack:undoStack,dest=redo?undoStack:redoStack;if(!src.length)return;pause();dest.push(snapshotCircuit());C=validateCircuit(JSON.parse(src.pop()));connection=null;selectedWire=null;rebuild(false);toast(redo?'Change restored':'Change undone');}
function addComponent(type,point){checkpoint();const r=$('#circuit').getBoundingClientRect();const pt=point||{x:(r.width/2-view.x)/view.z-56,y:(r.height/2-view.y)/view.z-43};let n=makeNode(type,snap(pt.x),snap(pt.y),['LED','SWITCH','CONST','NOT','AND','OR','XOR','NAND','NOR','BUFFER','TRISTATE','MUX','ADDER','COMPARE','SPLITTER','JOINER','ALU','DFF','LATCH','REGISTER','COUNTER','RAM'].includes(type)?settings.bits:1);while(C.nodes.some(a=>a.id===n.id))n=makeNode(type,n.x,n.y,n.bits);const base=TYPES[type].name.replace(' gate','');let label=base,k=1;while(C.nodes.some(a=>a.label===label))label=base+' '+(++k);n.label=label;C.nodes.push(n);selection=new Set([n.id]);selectedWire=null;rebuild();if(innerWidth<760){$('.palette').classList.remove('show');}toast(base+' added · connect its ports');}
const snap=v=>settings.snap?Math.round(v/20)*20:Math.round(v);
function setTool(t){tool=t;connection=null;$('#draft-wire').setAttribute('d','');for(const name of ['select','pan','wire','probe'])$('#'+name+'-tool')?.classList.toggle('active',t===name);$('#canvas-hint').textContent=t==='wire'?'Click an output, then an input · Esc to cancel':t==='pan'?'Drag the workspace to pan · Scroll to zoom':t==='probe'?'Click a wire or port to attach a named probe':'Click a switch to explore · Connect ports to build';$('#circuit').style.cursor=t==='pan'?'grab':t==='wire'||t==='probe'?'crosshair':'default';updateStatus();}
function connectPort(id,name,dir){if(tool==='probe'){openProbe({node:id,port:name});return;}const n=engine.nodes.get(id),port=portDefs(n).find(p=>p.name===name);if(!connection){connection={node:id,port:name,dir};toast('Choose a compatible '+(dir==='out'?'input':'output')+' port');return;}const start=connection;connection=null;$('#draft-wire').setAttribute('d','');if(start.dir===dir){toast('Connect an output to an input. These ports have the same direction.',true);return;}const from=dir==='in'?start:{node:id,port:name},to=dir==='in'?{node:id,port:name}:start;const w={id:'w'+wireID++,from:{node:from.node,port:from.port},to:{node:to.node,port:to.port}};try{validateCircuit({...C,wires:[...C.wires,w]});}catch(err){toast(err.message,true);return;}checkpoint();C.wires.push(w);selectedWire=w.id;selection.clear();rebuild();toast(engine.warnings[0]||'Connected · signal propagated',!!engine.warnings.length);}
function removeSelected(){if(!selection.size&&!selectedWire)return;checkpoint();const count=selection.size;C.nodes=C.nodes.filter(n=>!selection.has(n.id));C.wires=C.wires.filter(w=>w.id!==selectedWire&&!selection.has(w.from.node)&&!selection.has(w.to.node));C.probes=C.probes.filter(p=>!selection.has(p.node));selection.clear();selectedWire=null;rebuild();toast(count?count+' component'+(count===1?'':'s')+' deleted':'Wire deleted');}
function copy(){if(!selection.size){toast('Select components to copy',true);return;}clipboard={nodes:C.nodes.filter(n=>selection.has(n.id)).map(n=>JSON.parse(JSON.stringify(n))),wires:C.wires.filter(w=>selection.has(w.from.node)&&selection.has(w.to.node)).map(w=>JSON.parse(JSON.stringify(w)))};toast(selection.size+' component'+(selection.size===1?'':'s')+' copied');}
function paste(){if(!clipboard){toast('Copy a selection first',true);return;}checkpoint();const ids=new Map();selection.clear();for(const raw of clipboard.nodes){let fresh=makeNode(raw.type,raw.x+40,raw.y+40,raw.bits);while(C.nodes.some(n=>n.id===fresh.id))fresh=makeNode(raw.type,raw.x+40,raw.y+40,raw.bits);const n={...JSON.parse(JSON.stringify(raw)),id:fresh.id,x:raw.x+40,y:raw.y+40,label:raw.label+' copy'};ids.set(raw.id,n.id);C.nodes.push(n);selection.add(n.id);}for(const w of clipboard.wires)C.wires.push({id:'w'+wireID++,from:{node:ids.get(w.from.node),port:w.from.port},to:{node:ids.get(w.to.node),port:w.to.port}});clipboard.nodes=clipboard.nodes.map(n=>({...n,x:n.x+40,y:n.y+40}));selectedWire=null;rebuild();}
function toggle(id,pressed){const n=engine.nodes.get(id);if(!n)return;const value=pressed===undefined?(n.props.value+1)&mask(n.bits):pressed;checkpoint();engine.setSource(id,value);engine.settle();record('input');refreshSignals();autosave();}
function tick(){const before=engine.samples.length;engine.tick();if(!recording)engine.samples.splice(before);refreshSignals();}
function run(){if(running){pause();return;}running=true;$('#run-btn').innerHTML=icon('pause')+'<span>Pause</span>';timer=setInterval(()=>{tick();if(engine.oscillating)pause();},1000/settings.speed);updateStatus();}
function pause(){running=false;clearInterval(timer);timer=null;if($('#run-btn'))$('#run-btn').innerHTML=icon('play')+'<span>Run</span><span class="keycap desktop-only" style="background:#ffffff15;color:#e1f8eb;border-color:#ffffff30">Space</span>';updateStatus();}
function reset(){pause();engine.reset();waveCursor=null;refreshSignals();toast('Simulation reset · deterministic initial state');}
function toast(msg,error=false){$('.toast')?.remove();clearTimeout(toastTimer);const el=document.createElement('div');el.className='toast'+(error?' error':'');el.setAttribute('role',error?'alert':'status');el.textContent=msg;document.body.append(el);toastTimer=setTimeout(()=>el.remove(),4200);}
function renderInspector(force=true){const key=selectedWire?'wire:'+selectedWire:[...selection].join(',');if(!force&&key===inspectKey){$$('[data-live-value]').forEach(el=>{const [id,p,b]=el.dataset.liveValue.split('|');el.textContent=fmt(engine.read(id,p),+b);});$$('[data-live-class]').forEach(el=>{const [id,p]=el.dataset.liveClass.split('|');el.className='port-dot '+signalClass(engine.read(id,p));});const pe=$('#cpu-pc');if(pe){const n=C.nodes.find(n=>n.type==='PC');pe.textContent=n?fmt(engine.output(n.id),4,'hex'):'—';}if($('#cpu-program'))renderProgram();return;}inspectKey=key;const el=$('#inspector-content');if(selectedWire){const w=C.wires.find(w=>w.id===selectedWire);if(!w){selectedWire=null;return renderInspector();}const a=engine.nodes.get(w.from.node),b=engine.nodes.get(w.to.node),p=portDefs(a).find(p=>p.name===w.from.port);el.innerHTML=`<div class="inspector-symbol">${icon('wire')}</div><h2>Signal connection</h2><p>${esc(a.label)}.${w.from.port} → ${esc(b.label)}.${w.to.port}</p><div class="inspector-section"><h3>Live signal</h3><div class="detailrow"><span>Value</span><strong data-live-value="${a.id}|${p.name}|${p.width}">${esc(fmt(engine.output(a.id,p.name),p.width))}</strong></div><div class="detailrow"><span>Bus width</span><strong>${p.width} bit</strong></div><div class="detailrow"><span>Fan-out</span><strong>${engine.fanout.get(a.id+':'+p.name)?.length||0}</strong></div></div><button id="wire-add-probe" class="small" style="width:100%">${icon('probe')}Attach named probe</button><button id="delete-selection" class="textbtn small" style="width:100%;margin-top:10px">${icon('trash')}Delete wire</button>`;$('#wire-add-probe').onclick=()=>openProbe(w.from);$('#delete-selection').onclick=removeSelected;return;}
if(selection.size===1){const n=engine.nodes.get([...selection][0]);if(!n)return;const ports=portDefs(n);el.innerHTML=`<div class="inspector-symbol">${esc(TYPES[n.type].symbol)}</div><h2>${esc(n.label)}</h2><p>${esc(TYPES[n.type].desc)}</p><div class="inspector-section"><h3>Properties</h3><label>Label<input id="prop-label" aria-label="Component label" value="${esc(n.label)}" maxlength="64"></label><label>Bit width<select id="prop-bits" aria-label="Component bit width" ${['CLOCK','BUTTON','PC','ROM','CONTROL'].includes(n.type)?'disabled':''}>${Array.from({length:16},(_,i)=>`<option value="${i+1}" ${n.bits===i+1?'selected':''}>${i+1} bit${i?'s':''}</option>`).join('')}</select></label>${SOURCE.has(n.type)&&n.type!=='CLOCK'?`<label>Input value <span class="muted">(decimal or 0x hex)</span><input id="prop-value" aria-label="Input value" value="${n.props.value}" inputmode="numeric"></label>`:''}${SEQ.has(n.type)||n.type==='LATCH'?`<label>Initial value<input id="prop-initial" aria-label="Initial state" type="number" min="0" max="${mask(n.bits)}" value="${n.props.initial||0}"></label>`:''}${n.type==='ROM'||n.type==='RAM'?`<label>Memory words <span class="muted">(up to 16)</span><textarea id="prop-memory" aria-label="Memory words" class="json-input" style="height:75px">${(n.props.memory||[]).map(v=>'0x'+v.toString(16).toUpperCase()).join(', ')}</textarea></label><button id="apply-memory" class="small">Apply memory & reset</button>`:''}</div><div class="inspector-section"><h3>Live ports</h3>${ports.map(p=>`<div class="port-row"><span class="port-dot ${signalClass(engine.read(n.id,p.name))}" data-live-class="${n.id}|${p.name}"></span><span>${p.dir==='in'?'↳':'↗'} ${p.name} <span class="muted">${p.width}b</span></span><strong data-live-value="${n.id}|${p.name}|${p.width}">${esc(fmt(engine.read(n.id,p.name),p.width))}</strong><button data-probe-port="${p.name}" title="Probe ${p.name}" aria-label="Probe ${esc(n.label)} ${p.name}">+</button></div>`).join('')}</div><div class="inspector-section"><h3>Truth table</h3>${SOURCE.has(n.type)&&n.type!=='CLOCK'?`<label><input id="mark-input" type="checkbox" ${n.props.tableInput?'checked':''}>Mark as input</label>`:''}<label><input id="mark-output" type="checkbox" ${n.props.tableOutput?'checked':''}>Mark as output</label></div><div style="display:flex;gap:8px"><button id="duplicate-selection" class="small">${icon('copy')}Duplicate</button><button id="delete-selection" class="small textbtn">${icon('trash')}Delete</button></div>`;
$('#prop-label').onchange=e=>{const label=e.target.value.trim();if(!label){e.target.value=n.label;toast('A component needs a label',true);return;}checkpoint();n.label=label;renderScene();renderInspector();renderWave();autosave();};$('#prop-bits').onchange=e=>{checkpoint();n.bits=+e.target.value;n.props.value&=mask(n.bits);const before=C.wires.length;C.wires=C.wires.filter(w=>{if(w.from.node!==n.id&&w.to.node!==n.id)return true;const a=C.nodes.find(a=>a.id===w.from.node),b=C.nodes.find(b=>b.id===w.to.node),op=portDefs(a).find(p=>p.name===w.from.port&&p.dir==='out'),ip=portDefs(b).find(p=>p.name===w.to.port&&p.dir==='in');return op&&ip&&op.width===ip.width;});C.probes=C.probes.filter(p=>p.node!==n.id||portDefs(n).some(d=>d.name===p.port));rebuild();if(before!==C.wires.length)toast((before-C.wires.length)+' incompatible wire(s) disconnected');};if($('#prop-value'))$('#prop-value').onchange=e=>{const value=Number(e.target.value);if(!Number.isInteger(value)||value<0||value>mask(n.bits)){toast('Value must be 0–'+mask(n.bits),true);e.target.value=n.props.value;return;}checkpoint();engine.setSource(n.id,value);engine.settle();record('input');refreshSignals();autosave();};if($('#prop-initial'))$('#prop-initial').onchange=e=>{const v=Number(e.target.value);if(!Number.isInteger(v)||v<0||v>mask(n.bits)){toast('Initial state is out of range',true);return;}checkpoint();n.props.initial=v;autosave();};if($('#apply-memory'))$('#apply-memory').onclick=()=>{const txt=$('#prop-memory').value.trim();const values=txt?txt.split(/[\s,;]+/).map(Number):[];if(values.length>16||values.some(v=>!Number.isInteger(v)||v<0||v>mask(n.bits))){toast('Use at most 16 words, each 0–'+mask(n.bits),true);return;}checkpoint();n.props.memory=values;rebuild(false);toast('Memory image updated; simulation reset');};$$('[data-probe-port]').forEach(b=>b.onclick=()=>openProbe({node:n.id,port:b.dataset.probePort}));if($('#mark-input'))$('#mark-input').onchange=e=>{checkpoint();n.props.tableInput=e.target.checked;autosave();};$('#mark-output').onchange=e=>{checkpoint();n.props.tableOutput=e.target.checked;autosave();};$('#duplicate-selection').onclick=()=>{copy();paste();};$('#delete-selection').onclick=removeSelected;return;}
if(selection.size>1){el.innerHTML=`<div class="inspector-symbol">${icon('layers')}</div><h2>${selection.size} components selected</h2><p>Drag to move this group. Copy includes all wires between selected components.</p><button id="duplicate-selection" style="width:100%;margin-bottom:9px">${icon('copy')}Duplicate group</button><button id="delete-selection" style="width:100%">${icon('trash')}Delete selection</button><div class="help-card"><p>Shift-click to add or remove components from the selection.</p></div>`;$('#duplicate-selection').onclick=()=>{copy();paste();};$('#delete-selection').onclick=removeSelected;return;}
const inputs=C.nodes.filter(n=>SOURCE.has(n.type)&&n.type!=='CLOCK'),outs=C.nodes.filter(n=>n.type==='LED'),isCPU=C.nodes.some(n=>n.type==='CONTROL');el.innerHTML=`<div class="inspector-symbol">${icon(isCPU?'chip':'layers')}</div><h2>Circuit overview</h2><p>Build an idea, follow a signal.<br>Select any component to explore it.</p><div class="inspector-section"><h3>This experiment</h3><div class="detailrow"><span>Components</span><strong>${C.nodes.length}</strong></div><div class="detailrow"><span>Connections</span><strong>${C.wires.length}</strong></div><div class="detailrow"><span>Inputs / outputs</span><strong>${inputs.length} / ${outs.length}</strong></div><div class="detailrow"><span>Logic model</span><span class="pill tag-green">${C.nodes.some(n=>SEQ.has(n.type))?'Sequential':'Combinational'}</span></div></div>${outs.length?`<div class="inspector-section"><h3>Output signals</h3>${outs.map(n=>`<div class="detailrow"><span>${esc(n.label)}</span><strong data-live-value="${n.id}|A|${n.bits}">${fmt(engine.input(n.id,'A'),n.bits)}</strong></div>`).join('')}</div>`:''}${isCPU?`<div class="inspector-section"><h3>Program execution <span id="cpu-pc" class="mono" style="float:right"></span></h3><div id="cpu-program" class="program-grid"></div><p style="margin-top:10px">LDI 0 · OUT · ADD 1 · OUT · JMP 2<br>One instruction per rising edge.</p></div>`:`<div class="help-card"><span style="font-size:11px;font-weight:600">${icon('bolt')} Follow the green</span><p>Green wires carry a high signal. Click an input switch and watch the outputs respond.</p></div>`}<div class="inspector-section" style="margin-top:18px"><h3>Make it yours</h3><div class="shortcut-row"><span>Select & move</span><span class="keycap">V</span></div><div class="shortcut-row"><span>Connect a wire</span><span class="keycap">W</span></div><div class="shortcut-row"><span>Pan workspace</span><span class="keycap">H</span></div><div class="shortcut-row"><span>Step one tick</span><span class="keycap">T</span></div></div><button id="diagnostics-open" class="small textbtn" style="width:100%">${icon('event')}Simulation diagnostics</button>`;$('#diagnostics-open').onclick=openDiagnostics;if(isCPU)renderProgram();}
function renderProgram(){const pc=C.nodes.find(n=>n.type==='PC'),rom=C.nodes.find(n=>n.type==='ROM');if(!pc||!rom||!$('#cpu-program'))return;const addr=engine.output(pc.id);$('#cpu-pc').textContent=fmt(addr,4,'hex');$('#cpu-program').innerHTML=Array.from({length:16},(_,k)=>`<span class="${k===addr?'current':''}" title="Address ${k}: ${instruction(rom.props.memory?.[k]||0)}">${k.toString(16).toUpperCase()}: ${(rom.props.memory?.[k]||0).toString(16).padStart(2,'0').toUpperCase()}</span>`).join('');}
function instruction(v){const op=v>>4;return ({1:'LDI',2:'ADD',3:'JMP',4:'OUT',5:'HALT'}[op]||'NOP')+([1,2,3].includes(op)?' '+(v&15):'');}
let priorFocus=null;
function modal(title,subtitle,body,footer='',wide=false){closeModal();priorFocus=document.activeElement;const overlay=document.createElement('div');overlay.className='modal-backdrop';overlay.innerHTML=`<section class="modal" role="dialog" aria-modal="true" aria-labelledby="modal-title" ${wide?'style="width:830px"':''}><header class="modal-head"><div><h2 id="modal-title">${esc(title)}</h2><p>${esc(subtitle)}</p></div><span class="spacer"></span>${button('modal-close','Close dialog','close','textbtn iconbtn')}</header><div class="modal-body">${body}</div>${footer?`<footer class="modal-footer">${footer}</footer>`:''}</section>`;document.body.append(overlay);$('#modal-close').onclick=closeModal;overlay.addEventListener('pointerdown',e=>{if(e.target===overlay)closeModal();});overlay.addEventListener('keydown',e=>{if(e.key==='Escape'){e.stopPropagation();closeModal();}if(e.key==='Tab'){const elements=Array.from(overlay.querySelectorAll('button,input,select,textarea,[tabindex="0"]')).filter(el=>!el.disabled&&el.offsetParent!==null),first=elements[0],last=elements.at(-1);if(e.shiftKey&&document.activeElement===first){last.focus();e.preventDefault();}else if(!e.shiftKey&&document.activeElement===last){first.focus();e.preventDefault();}}});$('#modal-close').focus();}
function closeModal(){$('.modal-backdrop')?.remove();modalKind=null;priorFocus?.focus?.();}
function loadCircuit(raw,name){try{const validated=validateCircuit(raw);pause();checkpoint();C=validated;if(name)C.name=name;selection.clear();selectedWire=null;connection=null;projectId=null;rebuild(false);fit();closeModal();toast(C.name+' loaded');}catch(err){const el=$('#import-error');if(el)el.textContent=err.message;else toast(err.message,true);}}
const examples=[['half','Half adder','⊕','Start with two inputs and two gates.'],['full','Full adder','Σ','Add two bits and a carry input.'],['mux','Multiplexer','MUX','Route a 4-bit bus with a selector.'],['sr','SR latch','Q Q̅','Remember a bit with feedback.'],['register','Edge-triggered register','REG','Capture a value on a clock edge.'],['counter','Binary counter','+1','Count, step, and roll over.'],['alu','4-bit ALU','ALU','Explore arithmetic and bitwise logic.'],['memory','Memory test','RAM','Write and read a 16-word memory.'],['cpu','Tiny-4 CPU','μ4','A complete connected computer. Run a program, inspect every instruction.']];
function openExamples(){modal('A starting point for your next idea','Every experiment is a real, editable circuit. Loading one is undoable.',`<div class="example-grid">${examples.map(([key,name,symbol,desc])=>`<button class="example-card ${key==='cpu'?'cpu':''}" data-example="${key}"><span class="example-icon">${esc(symbol)}</span><b>${name}</b><p>${desc}</p></button>`).join('')}</div>`,`<button id="blank-btn">${icon('plus')}Blank circuit</button>`);$$('[data-example]').forEach(b=>b.onclick=()=>{loadCircuit(preset(b.dataset.example));$('#experiment-number').textContent=String(examples.findIndex(a=>a[0]===b.dataset.example)+1).padStart(2,'0');});$('#blank-btn').onclick=()=>loadCircuit(preset('blank'));}
function openProbe(target){const candidates=C.nodes.flatMap(n=>portDefs(n).filter(p=>p.dir==='out'||n.type==='LED').map(p=>({node:n.id,port:p.name,label:n.label+'.'+p.name,width:p.width})));if(target&&!candidates.some(p=>p.node===target.node&&p.port===target.port)){const n=engine.nodes.get(target.node),p=portDefs(n).find(p=>p.name===target.port);candidates.push({...target,label:n.label+'.'+p.name,width:p.width});}if(!candidates.length){toast('Add a component before attaching a probe',true);return;}const current=target?candidates.findIndex(p=>p.node===target.node&&p.port===target.port):0;modal('Attach a signal probe','Capture live values from a component port or its connected wire.',`<label class="formfield">Signal<select id="probe-target">${candidates.map((p,k)=>`<option value="${k}" ${k===current?'selected':''}>${esc(p.label)} · ${p.width} bit</option>`).join('')}</select></label><label class="formfield">Probe name<input id="probe-name" aria-label="Probe name" maxlength="40" value="${esc(candidates[Math.max(0,current)].label)}"></label><div class="notice">Samples come directly from the simulation, including X (unknown) and Z (floating). Capture is limited to the latest 1,024 samples.</div>`,`<button id="confirm-probe" class="primary">${icon('plus')}Attach probe</button>`);$('#probe-target').onchange=()=>$('#probe-name').value=candidates[+$('#probe-target').value].label;$('#confirm-probe').onclick=()=>{if(C.probes.length>=24){toast('Maximum 24 probes. Remove one to add another.',true);return;}const p=candidates[+$('#probe-target').value],name=$('#probe-name').value.trim();if(!name){toast('Enter a probe name',true);return;}checkpoint();let k=0;while(C.probes.some(p=>p.id==='p'+k))k++;C.probes.push({id:'p'+k,node:p.node,port:p.port,name,color:C.probes.length%6});record('probe');closeModal();setTool('select');renderWave();autosave();toast('Probe attached: '+name);};$('#probe-name').focus();}
function csv(){const ps=C.probes,quote=s=>'"'+String(s).replace(/"/g,'""')+'"';const rows=[['sample','time','tick','phase',...ps.map(p=>p.name)].map(quote).join(',')];for(const s of engine.samples)rows.push([s.index,s.time,s.tick,s.phase,...ps.map(p=>s.values[p.id]??'X')].map(quote).join(','));download(C.name+'-waveforms.csv',rows.join('\n'),'text/csv');toast(engine.samples.length+' live samples exported');}
function download(name,content,type){const blob=content instanceof Blob?content:new Blob([content],{type}),url=URL.createObjectURL(blob),a=document.createElement('a');a.href=url;a.download=name.replace(/[^\w .-]/g,'_');document.body.append(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(url),2000);}
function openSettings(){modal('Your laboratory, your rules','Simulation behavior and workspace preferences are saved on this device.',`<div class="settings-grid"><div><span class="eyebrow">Simulation</span><label class="formfield">Clock frequency (Hz)<input id="setting-speed" type="number" min="0.25" max="60" step="0.25" value="${settings.speed}"></label><label class="formfield">Propagation delay model<select id="setting-delay"><option value="zero">Zero delay · delta events</option><option value="unit">Unit delay · 1 per gate</option><option value="gate">Gate delay · arithmetic = 3</option></select></label><label class="formfield">Propagation step limit<input id="setting-limit" type="number" min="32" max="100000" step="32" value="${settings.limit}"></label><label class="formfield">Default bit width<select id="setting-bits">${Array.from({length:16},(_,i)=>`<option value="${i+1}">${i+1} bit${i?'s':''}</option>`).join('')}</select></label><label class="formfield">Value radix<select id="setting-radix"><option value="bin">Binary</option><option value="dec">Decimal</option><option value="hex">Hexadecimal</option></select></label></div><div><span class="eyebrow">Workspace</span><label class="formfield">Appearance<select id="setting-theme"><option value="light">Light · Paper</option><option value="dark">Dark · Phosphor</option></select></label><label class="formfield">Wire style<select id="setting-wire"><option value="smooth">Smooth curves</option><option value="orthogonal">Orthogonal</option><option value="straight">Straight</option></select></label><label class="formfield">Diagnostic overlay<select id="setting-overlay"><option value="none">None</option><option value="values">Bus values</option><option value="order">Evaluation order</option><option value="fanout">Fan-out counts</option><option value="clocks">Clock domains</option><option value="loops">Feedback loops</option></select></label>${[['grid','Show dot grid'],['snap','Snap to 20-unit grid'],['animation','Animate high signals'],['contrast','Color-blind / high contrast']].map(([key,name])=>`<label class="setting-line"><span>${name}</span><input id="setting-${key}" type="checkbox" ${settings[key]?'checked':''}></label>`).join('')}</div></div><div class="notice">Floating inputs are Z; unresolved or conflicting values are X. Clocked components sample together at each rising edge. Delay settings use simulation units, independent of clock speed.</div>`,`<button id="settings-diagnostics">${icon('event')}Diagnostics</button><button id="settings-done" class="primary">Done</button>`);for(const k of ['delay','bits','radix','theme','wire','overlay'])$('#setting-'+k).value=settings[k];$('#settings-diagnostics').onclick=openDiagnostics;$('#settings-done').onclick=closeModal;$$('[id^=setting-]').forEach(el=>el.onchange=()=>{const key=el.id.slice(8);let value=el.type==='checkbox'?el.checked:['speed','bits','limit'].includes(key)?+el.value:el.value;if(key==='speed'&&(!Number.isFinite(value)||value<.25||value>60)||key==='limit'&&(!Number.isInteger(value)||value<32||value>100000)){toast('Setting is outside its allowed range',true);el.value=settings[key];return;}settings[key]=value;applySettings();if(key==='speed'&&running){pause();run();}autosave();renderScene();renderInspector();renderWave();});}
function applySettings(){document.body.classList.toggle('theme-dark',settings.theme==='dark');document.body.classList.toggle('colorblind',settings.contrast);document.body.classList.toggle('no-animation',!settings.animation);if($('#grid-background'))$('#grid-background').style.display=settings.grid?'':'none';engine.options.limit=settings.limit;engine.options.delay=settings.delay;const select=$('#clock-speed');if(select){if(!Array.from(select.options).some(o=>+o.value===settings.speed))select.add(new Option(settings.speed+' Hz',settings.speed));select.value=settings.speed;}}
function openDiagnostics(){const labels=ids=>ids.map(id=>engine.nodes.get(id)?.label||id).join(' → ');const clocks=C.nodes.filter(n=>n.type==='CLOCK');const floating=C.nodes.flatMap(n=>portDefs(n).filter(p=>p.dir==='in'&&engine.input(n.id,p.name)==='Z').map(p=>n.label+'.'+p.name));modal('Simulation diagnostics','A live snapshot of the connected event simulator.',`<div class="diag-grid"><div class="diag-card"><h3>Scheduler</h3><pre>Time: ${engine.time} units\nClock: ${engine.ticks} ticks @ ${settings.speed} Hz\nLast settle: ${engine.iterations} evaluations\nTotal events: ${engine.events}\nDelay model: ${settings.delay}\nState: ${running?'Running':'Paused'}</pre></div><div class="diag-card"><h3>Dirty event queue · ${engine.queue.length}</h3><pre>${engine.queue.length?esc(engine.queue.slice(0,20).map(q=>engine.nodes.get(q.id).label+' @ '+q.time).join('\n')):'Queue empty. All scheduled events processed.'}</pre></div><div class="diag-card"><h3>Recent evaluation order</h3><pre>${esc(labels(engine.order.slice(-18))||'No evaluations yet')}</pre></div><div class="diag-card"><h3>Clock domains</h3><pre>${esc(clocks.map(c=>c.label+' → '+(engine.fanout.get(c.id+':Q')||[]).filter(d=>d.port==='CLK').map(d=>engine.nodes.get(d.node).label).join(', ')).join('\n')||'No clock source in this circuit.')}</pre></div><div class="diag-card"><h3>Feedback & contention</h3><pre>${esc(engine.warnings.join('\n')||'No unresolved signals or contention detected.')}\n${esc(engine.loops.length?engine.loops.map(l=>'Feedback: '+labels(l)).join('\n'):'No combinational feedback loops.')}</pre></div><div class="diag-card"><h3>Floating inputs · ${floating.length}</h3><pre>${esc(floating.slice(0,15).join('\n')||'All required inputs are connected.')}</pre></div></div>`,`<button id="refresh-diagnostics">${icon('reset')}Refresh snapshot</button><button id="diagnostics-done" class="primary">Done</button>`);$('#refresh-diagnostics').onclick=openDiagnostics;$('#diagnostics-done').onclick=closeModal;}
function openProjects(){let projects={};try{projects=JSON.parse(localStorage.getItem('bitwise-projects')||'{}');}catch{}modal('Your projects','Named projects and autosave stay in this browser. Export JSON to keep a portable copy.',`<label class="formfield">Project name<input id="project-name" value="${esc(C.name)}" maxlength="80" aria-label="Project name"></label><button id="save-project" class="primary">${icon('save')}Save project</button><div style="margin-top:25px"><span class="eyebrow">Saved on this device</span>${Object.keys(projects).length?Object.entries(projects).sort((a,b)=>b[1].saved-a[1].saved).map(([id,p])=>`<div class="project-row"><div><strong>${esc(p.circuit.name)}</strong><small>${p.circuit.nodes.length} components · ${new Date(p.saved).toLocaleDateString()}</small></div><button class="small" data-load-project="${esc(id)}">Open</button><button class="small textbtn" data-delete-project="${esc(id)}" aria-label="Delete saved project ${esc(p.circuit.name)}">${icon('trash')}</button></div>`).join(''):'<div class="empty-state">A home for your experiments.<br>Save your first project above.</div>'}</div>`,`<button id="project-import">${icon('upload')}Import JSON</button><button id="new-project">${icon('plus')}New circuit</button>`);$('#save-project').onclick=()=>{const name=$('#project-name').value.trim();if(!name){toast('Enter a project name',true);return;}checkpoint();C.name=name;const id=projectId||'project-'+Date.now();projects[id]={circuit:JSON.parse(snapshotCircuit()),saved:Date.now()};try{localStorage.setItem('bitwise-projects',JSON.stringify(projects));projectId=id;autosave();updateTitles();openProjects();toast('Project saved: '+name);}catch{toast('Browser storage is full or unavailable. Export JSON instead.',true);}};$$('[data-load-project]').forEach(b=>b.onclick=()=>{const id=b.dataset.loadProject;loadCircuit(projects[id].circuit);projectId=id;autosave();});$$('[data-delete-project]').forEach(b=>b.onclick=()=>{delete projects[b.dataset.deleteProject];try{localStorage.setItem('bitwise-projects',JSON.stringify(projects));openProjects();toast('Saved project removed; open circuit is unchanged');}catch{toast('Unable to update browser storage',true);}});$('#project-import').onclick=()=>openExport(true);$('#new-project').onclick=()=>loadCircuit(preset('blank'));}
async function exportSVG(png=false){const b=bounds(),pad=45,w=b.w+pad*2,h=b.h+pad*2;const styles=$('#app-style').textContent;const root=$('#circuit').cloneNode(true);root.setAttribute('xmlns','http://www.w3.org/2000/svg');root.setAttribute('width',w);root.setAttribute('height',h);root.setAttribute('viewBox',`${b.x-pad} ${b.y-pad} ${w} ${h}`);root.removeAttribute('role');root.querySelector('#world').removeAttribute('transform');root.querySelector('#grid-background')?.remove();root.querySelector('#draft-wire')?.remove();root.querySelector('#marquee')?.remove();const st=document.createElementNS('http://www.w3.org/2000/svg','style');st.textContent=styles.replace(/@media[\s\S]*/,'')+'svg{--panel:#fff;--ink:#25323b;--muted:#849099;--green:#159b78;--green-dark:#087f61;--high:#129d79;--low:#a4aeb8;--unknown:#dc9640;--font:Arial,sans-serif;--mono:monospace}.wire-flow{display:none}';root.insertBefore(st,root.firstChild);const bg=document.createElementNS('http://www.w3.org/2000/svg','rect');bg.setAttribute('x',b.x-pad);bg.setAttribute('y',b.y-pad);bg.setAttribute('width',w);bg.setAttribute('height',h);bg.setAttribute('fill','#f7f9fa');root.insertBefore(bg,root.querySelector('#world'));const xml=new XMLSerializer().serializeToString(root);if(!png){download(C.name+'.svg',xml,'image/svg+xml');toast('Circuit exported as SVG');return;}const blob=new Blob([xml],{type:'image/svg+xml'}),url=URL.createObjectURL(blob),img=new Image();img.onload=()=>{const canvas=document.createElement('canvas'),scale=Math.min(2,8000/Math.max(w,h));canvas.width=Math.ceil(w*scale);canvas.height=Math.ceil(h*scale);const ctx=canvas.getContext('2d');ctx.drawImage(img,0,0,canvas.width,canvas.height);URL.revokeObjectURL(url);canvas.toBlob(b=>{if(b){download(C.name+'.png',b,'image/png');toast('Circuit exported as PNG');}else toast('PNG export failed',true);},'image/png');};img.onerror=()=>{URL.revokeObjectURL(url);toast('PNG rendering failed. SVG is still available.',true);};img.src=url;}
function openExport(importFirst=false){modal(importFirst?'Import a circuit':'Take your circuit with you','Portable files. No account, cloud, or external services required.',`${importFirst?'':`<div class="export-grid"><button id="export-json">${icon('code')}Circuit JSON</button><button id="export-svg">${icon('layers')}Vector SVG</button><button id="export-png">${icon('download')}Image PNG</button><button id="export-csv">${icon('wave')}Waveform CSV</button></div><button id="share-btn" class="small textbtn">${icon('share')}Create a compact share link</button><div id="share-result"></div><hr style="border:0;border-top:1px solid var(--line);margin:20px 0">`}<span class="eyebrow">Import circuit</span><div class="file-zone" style="margin-top:12px">Choose an exported JSON file, or paste circuit JSON below.<br><input id="import-file" aria-label="Import circuit JSON file" type="file" accept=".json,application/json"></div><textarea id="import-json" class="json-input" aria-label="Circuit JSON to import" placeholder='{"version":1,"name":"My circuit","nodes":[],"wires":[]}'></textarea><div id="import-error" class="error-text" role="alert"></div><button id="import-paste">${icon('upload')}Import JSON</button>`);if(!importFirst){$('#export-json').onclick=()=>{download(C.name+'.json',JSON.stringify(C,null,2),'application/json');toast('Editable circuit exported');};$('#export-svg').onclick=()=>exportSVG();$('#export-png').onclick=()=>exportSVG(true);$('#export-csv').onclick=csv;$('#share-btn').onclick=async()=>{try{const json=JSON.stringify(C),data=new TextEncoder().encode(json);let bytes=data,prefix='j';if(typeof CompressionStream!=='undefined'){bytes=new Uint8Array(await new Response(new Blob([data]).stream().pipeThrough(new CompressionStream('deflate'))).arrayBuffer());prefix='z';}let binary='';for(const byte of bytes)binary+=String.fromCharCode(byte);const code=prefix+btoa(binary).replace(/\+/g,'-').replace(/\//g,'_').replace(/=+$/,'');const url=location.href.split('#')[0]+'#c='+code;$('#share-result').innerHTML=`<label class="formfield">${location.protocol==='file:'?'Circuit code · share this HTML file too':'Self-contained circuit link'}<textarea id="share-text" class="json-input" style="height:70px" readonly>${esc(url)}</textarea></label><button id="copy-share" class="small">Copy link</button><p class="muted" style="font-size:10px">The circuit is encoded in the link itself. No upload is made.</p>`;$('#copy-share').onclick=async()=>{try{await navigator.clipboard.writeText(url);toast('Share link copied');}catch{$('#share-text').select();toast('Link selected · press Ctrl+C to copy');}};}catch(err){toast('Could not create share link: '+err.message,true);}};}$('#import-paste').onclick=()=>{try{const txt=$('#import-json').value;if(txt.length>4e6)throw Error('Import exceeds 4 MB.');loadCircuit(JSON.parse(txt));}catch(err){$('#import-error').textContent='Invalid JSON: '+err.message;}};$('#import-file').onchange=async e=>{const file=e.target.files[0];if(!file)return;if(file.size>4e6){$('#import-error').textContent='Import exceeds 4 MB.';return;}try{loadCircuit(JSON.parse(await file.text()));}catch(err){$('#import-error').textContent='Invalid JSON: '+err.message;}};}
function simplify(minterms,bits,names){if(!minterms.length)return '0';if(minterms.length===2**bits)return '1';let current=minterms.map(v=>({term:v.toString(2).padStart(bits,'0'),covers:new Set([v])})),primes=[];while(current.length){const used=new Set(),next=new Map();for(let i=0;i<current.length;i++)for(let j=i+1;j<current.length;j++){let diff=0,pos=-1;for(let k=0;k<bits;k++)if(current[i].term[k]!==current[j].term[k]){diff++;pos=k;}if(diff===1&&current[i].term[pos]!=='-'&&current[j].term[pos]!=='-'){used.add(i);used.add(j);const term=current[i].term.slice(0,pos)+'-'+current[i].term.slice(pos+1);if(!next.has(term))next.set(term,{term,covers:new Set()});for(const v of [...current[i].covers,...current[j].covers])next.get(term).covers.add(v);}}current.forEach((v,i)=>{if(!used.has(i))primes.push(v);});current=[...next.values()];}const uncovered=new Set(minterms),chosen=[];for(const m of minterms){const ps=primes.filter(p=>p.covers.has(m));if(ps.length===1&&!chosen.includes(ps[0])){chosen.push(ps[0]);for(const v of ps[0].covers)uncovered.delete(v);}}while(uncovered.size){let best=null,score=0;for(const p of primes){const cover=[...p.covers].filter(v=>uncovered.has(v)).length;if(cover>score){best=p;score=cover;}}if(!best)break;chosen.push(best);for(const v of best.covers)uncovered.delete(v);}return chosen.map(p=>p.term.split('').map((bit,i)=>bit==='-'?'':bit==='0'?'¬'+names[i]:names[i]).filter(Boolean).join(' · ')).join(' + ');}
function openTruth(){const inputs=C.nodes.filter(n=>['SWITCH','BUTTON','CONST'].includes(n.type)),outputs=C.nodes.filter(n=>n.type==='LED'||n.props.tableOutput||selection.has(n.id)&&portDefs(n).some(p=>p.dir==='out'));if(!inputs.length||!outputs.length){modal('Truth table','Enumerate a combinational circuit.',`<div class="notice warning">Add an input switch and an output probe, or select a component with an output. Mark inputs and outputs in the inspector to choose your subcircuit.</div>`);return;}modal('From circuit to truth table','Choose boundary signals. Up to 8 input bits are enumerated through the real simulator.',`<div class="settings-grid"><div><span class="eyebrow">Input signals</span>${inputs.map(n=>`<label class="setting-line"><span>${esc(n.label)} <small>${n.bits} bit${n.bits>1?'s':''}</small></span><input type="checkbox" data-truth-input="${n.id}" ${n.props.tableInput||(!inputs.some(n=>n.props.tableInput)&&n.type==='SWITCH')?'checked':''}></label>`).join('')}</div><div><span class="eyebrow">Output signals</span>${outputs.map(n=>`<label class="setting-line"><span>${esc(n.label)} <small>${n.bits} bit${n.bits>1?'s':''}</small></span><input type="checkbox" data-truth-output="${n.id}" checked></label>`).join('')}</div></div><div id="truth-error" class="error-text" role="alert"></div><div id="truth-result"></div>`,`<button id="generate-truth" class="primary">${icon('table')}Generate truth table</button>`,true);$('#generate-truth').onclick=()=>{const ins=$$('[data-truth-input]:checked').map(el=>engine.nodes.get(el.dataset.truthInput)),outs=$$('[data-truth-output]:checked').map(el=>engine.nodes.get(el.dataset.truthOutput));const result=$('#truth-result'),err=$('#truth-error');err.textContent='';result.innerHTML='';const bits=ins.reduce((s,n)=>s+n.bits,0);if(!bits||!outs.length){err.textContent='Select at least one input and output.';return;}if(bits>8){err.textContent='This selection has '+bits+' input bits. Choose at most 8 (256 rows).';return;}const boundaries=new Set(ins.map(n=>n.id)),cone=new Set(),walk=id=>{if(cone.has(id)||boundaries.has(id))return;cone.add(id);for(const w of C.wires)if(w.to.node===id)walk(w.from.node);};outs.forEach(n=>walk(n.id));const sequential=[...cone].map(id=>engine.nodes.get(id)).filter(n=>SEQ.has(n.type)||n.type==='LATCH'||n.type==='CLOCK');if(sequential.length){err.textContent='This output depends on stored state or a clock ('+sequential.map(n=>n.label).join(', ')+'). Choose a combinational subcircuit.';return;}const rows=[];for(let k=0;k<2**bits;k++){const e=new Engine(C,{limit:settings.limit,delay:settings.delay});let offset=bits;const iv=ins.map(n=>{offset-=n.bits;const v=(k>>offset)&mask(n.bits);e.setSource(n.id,v);return v;});e.settle();const ov=outs.map(n=>n.type==='LED'?e.input(n.id,'A'):e.output(n.id,portDefs(n).find(p=>p.dir==='out').name));rows.push({i:iv,o:ov,ok:ov.every(known)&&!e.oscillating});}const unresolved=rows.filter(r=>!r.ok).length;let expressions='';if(bits<=6&&ins.every(n=>n.bits===1)){expressions=outs.map((n,j)=>n.bits===1&&!unresolved?esc(n.label)+' = '+esc(simplify(rows.map((r,k)=>r.o[j]===1?k:-1).filter(k=>k>=0),bits,ins.map(n=>n.label))):'').filter(Boolean).join('\n');}result.innerHTML=`<div class="notice ${unresolved?'warning':''}">${rows.length} combinations · ${unresolved?unresolved+' unresolved / non-settling rows':'All rows settled'} · Original circuit state preserved</div>${expressions?`<div class="expression">${expressions}</div><p class="muted" style="font-size:10px">Boolean summary · ¬ NOT · · AND · + OR</p>`:''}<div style="max-height:340px;overflow:auto;margin-top:15px"><table class="truth-table"><thead><tr><th>#</th>${ins.map(n=>`<th>${esc(n.label)}</th>`).join('')}${outs.map(n=>`<th>${esc(n.label)}</th>`).join('')}<th>State</th></tr></thead><tbody>${rows.map((r,k)=>`<tr><td class="muted">${k}</td>${r.i.map((v,i)=>`<td>${fmt(v,ins[i].bits)}</td>`).join('')}${r.o.map((v,j)=>`<td class="output-col">${fmt(v,outs[j].bits)}</td>`).join('')}<td>${r.ok?'✓':'X'}</td></tr>`).join('')}</tbody></table></div><button id="truth-csv" class="small" style="margin-top:15px">${icon('download')}Export truth table CSV</button>`;$('#truth-csv').onclick=()=>download(C.name+'-truth-table.csv',[['row',...ins.map(n=>n.label),...outs.map(n=>n.label),'settled'],...rows.map((r,k)=>[k,...r.i,...r.o,r.ok])].map(row=>row.map(v=>'"'+String(v).replace(/"/g,'""')+'"').join(',')).join('\n'),'text/csv');};}
function openHelp(){modal('Think in bits. Build something.','Your quick field guide to the digital logic laboratory.',`<div class="settings-grid"><div><span class="eyebrow">Build & explore</span><p style="font-size:12px;line-height:1.9">Click a palette component to add it, or drag it into the workspace. Click a switch to toggle a bit or increment a bus. Hold a push button to assert it.</p><p style="font-size:12px;line-height:1.9">Connect an output circle to an input circle. Bus widths must match. Select components to edit labels, widths, values, and memory. Attach probes from the inspector or the + Add probe control.</p><div class="notice">1 = active · 0 = low<br>X = unknown or conflicting · Z = floating<br>Defaults on optional enable/reset ports are shown by their live values.</div></div><div><span class="eyebrow">Keyboard shortcuts</span>${[['V / H','Select / pan tool'],['W / P','Wire / probe tool'],['Space','Run / pause'],['T / E','Clock tick / propagation event'],['R / F','Reset simulation / fit circuit'],['Ctrl Z / Shift Z','Undo / redo'],['Ctrl C / V / D','Copy / paste / duplicate'],['Ctrl A','Select all'],['Delete','Delete selection'],['Shift + click','Add to selection'],['Arrow keys','Move selection by grid step'],['Esc','Cancel wire / close dialog'],['Wheel / pinch','Zoom at pointer'],['Alt + drag','Pan workspace']].map(([key,label])=>`<div class="shortcut-row"><span>${label}</span><span class="keycap">${key}</span></div>`).join('')}</div></div><div class="notice">Step event advances one scheduled component evaluation. Editing an input settles its propagation automatically. Clock Step captures both half-cycles; waveform values are sampled after settling. Waveform CSV includes tick, phase, and simulation time.</div>`,`<button id="help-done" class="primary">Start exploring</button>`);$('#help-done').onclick=closeModal;}
function contextMenu(e){e.preventDefault();$('.contextmenu')?.remove();const node=e.target.closest('[data-id]'),wire=e.target.closest('[data-wire]');if(node&&!selection.has(node.dataset.id)){selection=new Set([node.dataset.id]);selectedWire=null;renderScene();renderInspector();}if(wire){selectedWire=wire.dataset.wire;selection.clear();renderScene();renderInspector();}const el=document.createElement('div');el.className='contextmenu';el.style.left=Math.min(e.clientX,innerWidth-185)+'px';el.style.top=Math.min(e.clientY,innerHeight-210)+'px';el.innerHTML=`<button data-context="copy">${icon('copy')}Copy <span>Ctrl C</span></button><button data-context="paste">${icon('layers')}Paste <span>Ctrl V</span></button><button data-context="duplicate">${icon('plus')}Duplicate <span>Ctrl D</span></button><button data-context="delete">${icon('trash')}Delete <span>Del</span></button><button data-context="fit">${icon('fit')}Fit circuit <span>F</span></button>`;document.body.append(el);el.onclick=e=>{const b=e.target.closest('[data-context]');if(!b)return;const a=b.dataset.context;el.remove();if(a==='copy')copy();if(a==='paste')paste();if(a==='duplicate'){copy();paste();}if(a==='delete')removeSelected();if(a==='fit')fit();};}
const pointers=new Map();let pinch=null;
function bind(){for(const t of ['select','pan','wire','probe'])$('#'+t+'-tool').onclick=()=>setTool(t);$('#component-search').oninput=e=>renderPalette(e.target.value);$('#palette-list').onclick=e=>{const b=e.target.closest('[data-add]');if(b)addComponent(b.dataset.add);};$('#palette-list').ondragstart=e=>{const b=e.target.closest('[data-add]');if(b)e.dataTransfer.setData('application/bitwise-component',b.dataset.add);};$('#circuit').ondragover=e=>e.preventDefault();$('#circuit').ondrop=e=>{e.preventDefault();const type=e.dataTransfer.getData('application/bitwise-component');if(TYPES[type])addComponent(type,worldPoint(e));};$('#undo-btn').onclick=()=>history();$('#redo-btn').onclick=()=>history(true);$('#run-btn').onclick=run;$('#tick-btn').onclick=()=>{pause();tick();};$('#event-btn').onclick=()=>{pause();if(!engine.queue.length){engine.circuit.nodes.forEach(n=>engine.enqueue(n.id));}engine.event();engine.iterations=1;engine.diagnose();record('event');refreshSignals();};$('#reset-btn').onclick=reset;$('#clock-speed').onchange=e=>{settings.speed=+e.target.value;if(running){pause();run();}autosave();updateStatus();};$('#zoom-in').onclick=()=>zoom(1.2);$('#zoom-out').onclick=()=>zoom(1/1.2);$('#fit-btn').onclick=fit;$('#grid-btn').onclick=()=>{settings.grid=!settings.grid;applySettings();autosave();};$('#palette-btn').onclick=()=>{$('.palette').classList.toggle('show');$('.inspector').classList.remove('show');};$('#palette-close').onclick=()=>$('.palette').classList.remove('show');$('#inspector-btn').onclick=()=>{$('.inspector').classList.toggle('show');$('.palette').classList.remove('show');};$('#overview-btn').onclick=()=>{$('.inspector').classList.toggle('show');$('.palette').classList.remove('show');renderInspector();};$('#close-inspector').onclick=()=>$('.inspector').classList.remove('show');$('#projects-btn').onclick=openProjects;$('#examples-btn').onclick=openExamples;$('#export-btn').onclick=()=>openExport();$('#settings-btn').onclick=openSettings;$('#help-btn').onclick=openHelp;$('#truth-btn').onclick=openTruth;$('#table-tab').onclick=openTruth;$('#analyzer-tab').onclick=()=>$('.analyzer').classList.remove('collapsed');$('#add-probe-btn').onclick=()=>openProbe();$('#csv-btn').onclick=csv;$('#wave-minus').onclick=()=>{waveZoom=Math.max(14,waveZoom/1.3);renderWave();};$('#wave-plus').onclick=()=>{waveZoom=Math.min(140,waveZoom*1.3);renderWave();};$('#collapse-analyzer').onclick=()=>{$('.analyzer').classList.toggle('collapsed');setTimeout(applyView,0);};$('#capture-status').parentElement.style.cursor='pointer';$('#capture-status').parentElement.title='Click to pause or resume recording';$('#capture-status').parentElement.onclick=()=>{recording=!recording;$('#capture-status').textContent=recording?'LIVE':'HOLD';};$('#probe-labels').onclick=e=>{const b=e.target.closest('[data-remove-probe]');if(b){checkpoint();C.probes=C.probes.filter(p=>p.id!==b.dataset.removeProbe);renderWave();autosave();}};$('#waveform').onpointermove=e=>{const r=e.currentTarget.getBoundingClientRect();waveCursor=e.clientX-r.left;const i=Math.max(0,Math.min(engine.samples.length-1,Math.floor((waveCursor-14)/waveZoom))),s=engine.samples[i];if(s){const row=Math.floor((e.clientY-r.top-23)/31),p=C.probes[row];$('#wave-readout').textContent='Tick '+s.tick+' · '+s.phase+' · t='+s.time+(p?' · '+p.name+' = '+(s.values[p.id]??'X'):'');}renderWave();};$('#waveform').onpointerleave=()=>{waveCursor=null;renderWave();};$('#minimap').onpointerdown=e=>{const m=e.currentTarget._map,r=e.currentTarget.getBoundingClientRect(),sr=$('#circuit').getBoundingClientRect();const x=(e.clientX-r.left)*125/r.width,y=(e.clientY-r.top)*76/r.height;view.x=sr.width/2-((x-m.ox)/m.s+m.b.x)*view.z;view.y=sr.height/2-((y-m.oy)/m.s+m.b.y)*view.z;applyView();};
const svg=$('#circuit');svg.addEventListener('wheel',e=>{e.preventDefault();if(e.shiftKey){view.x-=e.deltaY;applyView();}else zoom(Math.exp(-e.deltaY*.0014),{x:e.clientX,y:e.clientY});},{passive:false});svg.addEventListener('contextmenu',contextMenu);
svg.addEventListener('pointerdown',e=>{if(e.button===2)return;pointers.set(e.pointerId,{x:e.clientX,y:e.clientY});if(pointers.size===2){const ps=[...pointers.values()];pinch={distance:Math.hypot(ps[1].x-ps[0].x,ps[1].y-ps[0].y),center:{x:(ps[0].x+ps[1].x)/2,y:(ps[0].y+ps[1].y)/2}};drag=null;return;}const port=e.target.closest('.port');if(port){e.preventDefault();connectPort(port.dataset.node,port.dataset.port,port.dataset.dir);return;}const toggleEl=e.target.closest('[data-toggle]');if(toggleEl&&tool==='select'){e.preventDefault();const n=engine.nodes.get(toggleEl.dataset.toggle);selection=new Set([n.id]);selectedWire=null;if(n.type==='BUTTON'){toggle(n.id,1);drag={kind:'button',id:n.id,pointer:e.pointerId};svg.setPointerCapture(e.pointerId);}else toggle(n.id);renderInspector();return;}const point=worldPoint(e),nodeEl=e.target.closest('[data-id]'),wireEl=e.target.closest('[data-wire]');svg.focus({preventScroll:true});if(tool==='pan'||e.button===1||e.altKey){e.preventDefault();drag={kind:'pan',start:{x:e.clientX,y:e.clientY},view:{...view},pointer:e.pointerId};svg.setPointerCapture(e.pointerId);return;}if(nodeEl){const id=nodeEl.dataset.id;if(tool==='probe'){const n=engine.nodes.get(id),p=portDefs(n).find(p=>p.dir==='out')||portDefs(n)[0];openProbe({node:id,port:p.name});return;}if(e.shiftKey){if(selection.has(id))selection.delete(id);else selection.add(id);}else if(!selection.has(id))selection=new Set([id]);selectedWire=null;drag={kind:'nodes',point,start:{x:e.clientX,y:e.clientY},orig:new Map([...selection].map(id=>{const n=engine.nodes.get(id);return [id,{x:n.x,y:n.y}];})),moved:false,history:snapshotCircuit(),pointer:e.pointerId};svg.setPointerCapture(e.pointerId);renderScene();renderInspector();return;}if(wireEl){selectedWire=wireEl.dataset.wire;selection.clear();if(tool==='probe'){const w=C.wires.find(w=>w.id===selectedWire);openProbe(w.from);}renderScene();renderInspector();return;}if(connection)return;if(!e.shiftKey){selection.clear();selectedWire=null;}drag={kind:'marquee',point,old:new Set(selection),pointer:e.pointerId};svg.setPointerCapture(e.pointerId);renderScene();renderInspector();});
svg.addEventListener('pointermove',e=>{if(pointers.has(e.pointerId))pointers.set(e.pointerId,{x:e.clientX,y:e.clientY});if(pinch&&pointers.size===2){const ps=[...pointers.values()],distance=Math.hypot(ps[1].x-ps[0].x,ps[1].y-ps[0].y),center={x:(ps[0].x+ps[1].x)/2,y:(ps[0].y+ps[1].y)/2};zoom(distance/pinch.distance,center);view.x+=center.x-pinch.center.x;view.y+=center.y-pinch.center.y;pinch={distance,center};applyView();return;}const pt=worldPoint(e);if(connection){const n=engine.nodes.get(connection.node),a=portPosition(n,connection.port);$('#draft-wire').setAttribute('d',connection.dir==='out'?route(a,pt):route(pt,a));}if(!drag||drag.pointer!==e.pointerId)return;if(drag.kind==='pan'){view.x=drag.view.x+e.clientX-drag.start.x;view.y=drag.view.y+e.clientY-drag.start.y;applyView();}else if(drag.kind==='nodes'){const dx=pt.x-drag.point.x,dy=pt.y-drag.point.y;if(Math.hypot(e.clientX-drag.start.x,e.clientY-drag.start.y)>3)drag.moved=true;if(!drag.moved)return;for(const [id,orig]of drag.orig){const n=engine.nodes.get(id);n.x=snap(orig.x+dx);n.y=snap(orig.y+dy);}renderScene();const primary=engine.nodes.get([...selection][0]);if(primary){const others=C.nodes.filter(n=>!selection.has(n.id)),sameX=others.find(n=>Math.abs(n.x-primary.x)<8),sameY=others.find(n=>Math.abs(n.y-primary.y)<8);$('#guides').innerHTML=(sameX?`<path class="guide" d="M${primary.x} ${Math.min(primary.y,sameX.y)-30}V${Math.max(primary.y,sameX.y)+120}"/>`:'')+(sameY?`<path class="guide" d="M${Math.min(primary.x,sameY.x)-30} ${primary.y}H${Math.max(primary.x,sameY.x)+140}"/>`:'');}}else if(drag.kind==='marquee'){const x=Math.min(pt.x,drag.point.x),y=Math.min(pt.y,drag.point.y),w=Math.abs(pt.x-drag.point.x),h=Math.abs(pt.y-drag.point.y);selection=new Set(drag.old);for(const n of C.nodes){const d=dims(n);if(n.x+d.w>=x&&n.x<=x+w&&n.y+d.h>=y&&n.y<=y+h)selection.add(n.id);}const box=$('#marquee');for(const [k,v]of Object.entries({x,y,width:w,height:h}))box.setAttribute(k,v);box.style.display='';$$('.circuit-node').forEach(el=>el.classList.toggle('selected',selection.has(el.dataset.id)));}});
const end=e=>{pointers.delete(e.pointerId);if(pointers.size<2)pinch=null;if(!drag||drag.pointer!==e.pointerId)return;const state=drag;drag=null;if(state.kind==='button'){const n=engine.nodes.get(state.id);if(n){engine.setSource(n.id,0);engine.settle();record('release');refreshSignals();autosave();}}if(state.kind==='nodes'&&state.moved){undoStack.push(state.history);if(undoStack.length>80)undoStack.shift();redoStack=[];autosave();}$('#marquee').style.display='none';$('#guides').innerHTML='';renderScene();renderInspector();};svg.addEventListener('pointerup',end);svg.addEventListener('pointercancel',end);svg.addEventListener('lostpointercapture',e=>{if(drag?.pointer===e.pointerId)end(e);});
svg.addEventListener('keydown',e=>{const port=e.target.closest('.port'),toggleEl=e.target.closest('[data-toggle]');if((e.key==='Enter'||e.key===' ')&&port){e.preventDefault();e.stopPropagation();connectPort(port.dataset.node,port.dataset.port,port.dataset.dir);}else if((e.key==='Enter'||e.key===' ')&&toggleEl){e.preventDefault();e.stopPropagation();const n=engine.nodes.get(toggleEl.dataset.toggle);if(n.type==='BUTTON'){toggle(n.id,1);setTimeout(()=>{engine.setSource(n.id,0);engine.settle();record('release');refreshSignals();},150);}else toggle(n.id);}});
$('#analyzer-resizer').onpointerdown=e=>{const start=e.clientY,h=$('.analyzer').offsetHeight;const move=ev=>{const next=Math.max(100,Math.min(innerHeight*.55,h+start-ev.clientY));$('.analyzer').style.height=next+'px';};const up=()=>{window.removeEventListener('pointermove',move);window.removeEventListener('pointerup',up);applyView();renderWave();};window.addEventListener('pointermove',move);window.addEventListener('pointerup',up);};
document.addEventListener('pointerdown',e=>{if(!e.target.closest('.contextmenu'))$('.contextmenu')?.remove();});document.addEventListener('keydown',e=>{if($('.modal-backdrop'))return;const isField=/^(INPUT|TEXTAREA|SELECT)$/.test(e.target.tagName)||e.target.isContentEditable;if(isField)return;const key=e.key.toLowerCase(),mod=e.ctrlKey||e.metaKey;if(mod&&key==='z'){e.preventDefault();history(e.shiftKey);return;}if(mod&&key==='y'){e.preventDefault();history(true);return;}if(mod&&['a','c','v','d','s'].includes(key)){e.preventDefault();if(key==='a'){selection=new Set(C.nodes.map(n=>n.id));selectedWire=null;renderScene();renderInspector();}if(key==='c')copy();if(key==='v')paste();if(key==='d'){copy();paste();}if(key==='s')openProjects();return;}if(key==='escape'){connection=null;$('#draft-wire').setAttribute('d','');$('.contextmenu')?.remove();$('.palette').classList.remove('show');$('.inspector').classList.remove('show');return;}if(key==='delete'||key==='backspace'){e.preventDefault();removeSelected();return;}if(key===' '){e.preventDefault();run();return;}if(['arrowleft','arrowright','arrowup','arrowdown'].includes(key)&&selection.size){e.preventDefault();checkpoint();const step=e.shiftKey?100:settings.snap?20:1;for(const id of selection){const n=engine.nodes.get(id);n.x+=key==='arrowleft'?-step:key==='arrowright'?step:0;n.y+=key==='arrowup'?-step:key==='arrowdown'?step:0;}renderScene();autosave();return;}if(key==='v')setTool('select');if(key==='h')setTool('pan');if(key==='w')setTool('wire');if(key==='p')setTool('probe');if(key==='t'){pause();tick();}if(key==='e')$('#event-btn').click();if(key==='r')reset();if(key==='f')fit();if(key==='/'){e.preventDefault();$('.palette').classList.add('show');$('#component-search').focus();}if(key==='?')openHelp();});
new ResizeObserver(()=>{applyView();renderWave();}).observe($('.workspace'));window.addEventListener('blur',()=>{if(drag?.kind==='button'){const n=engine.nodes.get(drag.id);drag=null;if(n){engine.setSource(n.id,0);engine.settle();record('release');refreshSignals();}}});window.addEventListener('beforeunload',()=>{try{localStorage.setItem('bitwise-autosave',JSON.stringify({circuit:C,projectId}));}catch{}});}
function frame(now){frameCount++;if(now-lastFPS>=1000){fps=Math.round(frameCount*1000/(now-lastFPS));frameCount=0;lastFPS=now;updateStatus();}if(dirty&&now-lastPaint>30){renderScene();lastPaint=now;}requestAnimationFrame(frame);}
async function loadHash(){if(!location.hash.startsWith('#c='))return;try{const code=location.hash.slice(3);if(code.length>800000)throw Error('Share data is too large.');const bytes=Uint8Array.from(atob(code.slice(1).replace(/-/g,'+').replace(/_/g,'/')),c=>c.charCodeAt(0));let data=bytes;if(code[0]==='z'){if(typeof DecompressionStream==='undefined')throw Error('This browser cannot unpack compact links. Import JSON instead.');const reader=new Blob([bytes]).stream().pipeThrough(new DecompressionStream('deflate')).getReader();let total=0,chunks=[];while(true){const {value,done}=await reader.read();if(done)break;total+=value.length;if(total>4e6){reader.cancel();throw Error('Unpacked circuit exceeds 4 MB.');}chunks.push(value);}data=new Uint8Array(total);let offset=0;for(const chunk of chunks){data.set(chunk,offset);offset+=chunk.length;}}else if(code[0]!=='j')throw Error('Unrecognized share format.');loadCircuit(JSON.parse(new TextDecoder().decode(data)));}catch(err){toast('Share link: '+err.message,true);}}
mount();requestAnimationFrame(frame);loadHash();
window.Lab={get circuit(){return C;},get engine(){return engine;},get selection(){return [...selection];},get view(){return {...view};},get settings(){return {...settings};},get running(){return running;},diagnostics(){return {components:C.nodes.length,wires:C.wires.length,pending:engine.queue.length,time:engine.time,tick:engine.ticks,iterations:engine.iterations,warnings:[...engine.warnings],loops:engine.loops,selected:[...selection],running,tool,view:{...view},samples:engine.samples.slice(-12),signals:C.nodes.map(n=>({id:n.id,label:n.label,type:n.type,bits:n.bits,ports:Object.fromEntries(portDefs(n).map(p=>[p.name,engine.read(n.id,p.name)]))}))};}};
})();
