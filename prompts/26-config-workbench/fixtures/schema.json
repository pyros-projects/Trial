{
  "type": "object",
  "required": [
    "service",
    "features",
    "endpoints"
  ],
  "additionalProperties": false,
  "properties": {
    "service": {
      "type": "object",
      "required": [
        "name",
        "port",
        "limits"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "limits": {
          "type": "object",
          "required": [
            "rate",
            "burst"
          ],
          "additionalProperties": false,
          "properties": {
            "rate": {
              "type": "integer",
              "minimum": 0
            },
            "burst": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "features": {
      "type": "object",
      "required": [
        "beta"
      ],
      "additionalProperties": false,
      "properties": {
        "beta": {
          "type": "boolean"
        }
      }
    },
    "endpoints": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
