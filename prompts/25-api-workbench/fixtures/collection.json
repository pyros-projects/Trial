{
  "name": "Pagination smoke test",
  "requests": [
    {
      "name": "First page",
      "method": "GET",
      "path": "/items?cursor=0",
      "assertions": [
        {
          "kind": "status",
          "equals": 200
        },
        {
          "kind": "json",
          "path": "$.items[0].id",
          "equals": "item-1"
        }
      ],
      "extract": {
        "next": "$.next_cursor"
      }
    },
    {
      "name": "Second page",
      "method": "GET",
      "path": "/items?cursor={{next}}",
      "assertions": [
        {
          "kind": "status",
          "equals": 200
        },
        {
          "kind": "json",
          "path": "$.items[0].id",
          "equals": "item-3"
        }
      ]
    }
  ],
  "intentional_failure": {
    "kind": "json",
    "path": "$.items[0].id",
    "equals": "intentionally-not-an-item"
  }
}
