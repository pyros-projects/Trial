{
  "id": "WF-APPROVAL",
  "version": 1,
  "nodes": [
    {
      "id": "start",
      "type": "input"
    },
    {
      "id": "prepare",
      "type": "transform",
      "assign": {
        "priority": {
          "literal": "high"
        }
      }
    },
    {
      "id": "decision",
      "type": "condition",
      "path": "request.amount",
      "operator": ">",
      "literal": 10000
    },
    {
      "id": "review",
      "type": "approval"
    },
    {
      "id": "post",
      "type": "http",
      "method": "POST",
      "path": "/effects",
      "timeout_ms": 300,
      "max_attempts": 3
    },
    {
      "id": "wait",
      "type": "delay",
      "milliseconds": 1000
    },
    {
      "id": "done",
      "type": "end"
    },
    {
      "id": "small",
      "type": "end"
    }
  ],
  "edges": [
    {
      "from": "start",
      "to": "prepare"
    },
    {
      "from": "prepare",
      "to": "decision"
    },
    {
      "from": "decision",
      "to": "review",
      "branch": "true"
    },
    {
      "from": "decision",
      "to": "small",
      "branch": "false"
    },
    {
      "from": "review",
      "to": "post"
    },
    {
      "from": "post",
      "to": "wait"
    },
    {
      "from": "wait",
      "to": "done"
    }
  ]
}
