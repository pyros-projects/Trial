{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/frontier-agentic-benchmark/metadata.schema.json",
  "title": "Trial Run Metadata",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "task_id"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "enum": [
        "01-fluid-simulation",
        "02-hydraulic-erosion",
        "03-modular-synth",
        "04-deformable-physics",
        "05-black-hole-lensing",
        "06-wave-laboratory",
        "07-orbital-mission-planner",
        "08-sdf-csg-studio",
        "09-falling-sand-alchemy",
        "10-stealth-heist",
        "11-factory-automation",
        "12-rhythm-bullet-hell",
        "13-drone-racing",
        "14-evolution-ecosystem",
        "15-digital-logic-lab",
        "16-procedural-roguelike",
        "17-echo-loop-puzzler",
        "18-weather-storm-lab",
        "19-node-graphics-studio",
        "20-city-traffic-transit",
        "21-import-studio",
        "22-resource-booker",
        "23-stockroom",
        "24-workflow-desk",
        "25-api-workbench",
        "26-config-workbench",
        "27-field-notebook",
        "28-approval-desk",
        "29-sheetcraft",
        "30-project-planner"
      ]
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "model_version": {
      "type": "string"
    },
    "provider": {
      "type": "string"
    },
    "run_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "notes": {
      "type": "string"
    },
    "parameters": {
      "type": "object"
    },
    "environment": {
      "type": "object"
    },
    "metrics": {
      "type": "object"
    },
    "track": {
      "type": "string",
      "enum": [
        "html",
        "real-apps"
      ]
    },
    "rubric": {
      "type": "string",
      "enum": [
        "html-v1",
        "real-apps-v1"
      ]
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "score": {
      "$ref": "#/$defs/score"
    },
    "preview_url": {
      "type": "string",
      "format": "uri",
      "description": "Optional manually started HTTP(S) application on localhost or a literal loopback address with an explicit port. Server-side validator enforces this boundary; no auto-start or proxy."
    }
  },
  "$defs": {
    "score": {
      "oneOf": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        {
          "type": "object",
          "required": [
            "total"
          ],
          "properties": {
            "total": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "launch": {
              "type": "number"
            },
            "completeness": {
              "type": "number"
            },
            "behavior": {
              "type": "number"
            },
            "interaction": {
              "type": "number"
            },
            "technical_depth": {
              "type": "number"
            },
            "visual_quality": {
              "type": "number"
            },
            "robustness": {
              "type": "number"
            },
            "constraint_compliance": {
              "type": "number"
            }
          },
          "additionalProperties": true
        }
      ]
    }
  }
}
