{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evaluator-supplied run report",
  "type": "object",
  "properties": {
    "total": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "rubric": {
      "enum": [
        "html-v1",
        "real-apps-v1"
      ]
    },
    "evaluator": {
      "type": "string"
    },
    "artifact_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string"
          },
          "status": {
            "enum": [
              "pass",
              "fail",
              "blocked",
              "not-run"
            ]
          },
          "evidence": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
