{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Real Apps authored project manifest",
  "type": "object",
  "required": [
    "schema_version",
    "task_id",
    "track",
    "name",
    "stack",
    "commands",
    "health_path"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "task_id": {
      "enum": [
        "21-import-studio",
        "22-resource-booker",
        "23-stockroom",
        "24-workflow-desk",
        "25-api-workbench",
        "26-config-workbench",
        "27-field-notebook",
        "28-approval-desk",
        "29-sheetcraft",
        "30-project-planner"
      ]
    },
    "track": {
      "const": "real-apps"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "stack": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "commands": {
      "type": "object",
      "required": [
        "setup",
        "start",
        "test",
        "reset"
      ],
      "properties": {
        "setup": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "start": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "test": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "reset": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "health_path": {
      "const": "/health"
    }
  },
  "additionalProperties": true
}
